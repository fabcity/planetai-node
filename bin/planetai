#!/usr/bin/env bash
# planetai — the one command an operator needs. Installed to ~/.local/bin by the bootstrap.
#
#   planetai preflight      can this machine run a node? checks only; changes nothing (--json)
#   planetai setup          ask four things, install, start
#   planetai status         is it alive, what has it read
#   planetai doctor         checks, with the fix named for each failure
#   planetai telegram       connect a bot: guided, finds your chat id for you
#   planetai test-alert     make a real alert fire now, so you see the whole path
#   planetai update         back up, pull, migrate, rebuild, verify
#   planetai logs           follow the node's log
#   planetai config         open .env in an editor
#   planetai report         write and send one now; `report last` shows the last one
#   planetai report every 6 hours between reports: 3, 4, 6, 8, 12 or 24
#   planetai report at 6   the local hour the rhythm starts from
#   planetai report level   what interrupts you between reports: act | warn | info
#   planetai act <id>       your note on what you did about alert <id>
#   planetai mesh           join the tailnet: reach this node from anywhere, no open ports
#   planetai meshtastic     LoRa sensors and alerts via a gateway radio (sets up the broker, prints gateway settings)
#   planetai reticulum      give the node an LXMF address: encrypted messaging over TCP or LoRa (RNode)
#   planetai homeassistant  publish sensors and alerts as Home Assistant entities (MQTT discovery)
#   planetai packs          what is loaded; `packs install` adds code-pack settings to .env and their libraries to the image
#   planetai ui             the dashboard: where it is, and the token that unlocks its settings pages
#   planetai storage        where the data lives, where backups and copies go, exports, IPFS; `set` to change
#   planetai backup         dump + export + copy now, instead of waiting for 03:17
#   planetai restore <f>    replace the live database with a dump (takes a safety backup first)
#   planetai ipfs           publish each day's export to IPFS
#   planetai agent          connect an AI agent: the MCP endpoint, the token, config snippets
#   planetai agent local    a model on this machine (Ollama) that runs the node and answers on Telegram; `agent stop` stops it
#   planetai run <pack> <script> [args]   run a script a pack ships; output lands in out/
#   planetai sensors         every sensor the node knows: yours and the references (--json)
#   planetai cells           the Index cells this node fills, with provenance (--json)
#   planetai geocode <place> what the setup wizard would find for a place name
#   planetai version         the version this folder is at
#   planetai remove         take this node off the machine; asks twice. --keep-data keeps the readings
#   planetai stop | start | restart
set -euo pipefail

# The node is wherever this script really lives (it is symlinked into ~/.local/bin). PLANETAI_HOME overrides.
resolve() { local t="$1"; while [[ -L "$t" ]]; do local d; d="$(cd "$(dirname "$t")" && pwd)"; t="$(readlink "$t")"; [[ "$t" != /* ]] && t="$d/$t"; done; echo "$t"; }
HOME_DIR="${PLANETAI_HOME:-$(cd "$(dirname "$(resolve "$0")")/.." && pwd)}"
LOG="$HOME_DIR/.planetai-setup.log"
cd "$HOME_DIR" 2>/dev/null || { echo "no node at $HOME_DIR. Install with: curl -fsSL planetai.fab.city/install | bash"; exit 1; }
# every long step appends here and nothing ever trimmed it: node #1's was 600 KB after four days. Keep the last ~200 KB.
if [[ -f "$LOG" ]] && [[ "$(wc -c < "$LOG" | tr -d ' ')" -gt 1000000 ]]; then tail -c 200000 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"; fi

# ---------------------------------------------------------------- tiny ui, no dependencies
B=$'\033[1m'; D=$'\033[2m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; BL=$'\033[34m'; N=$'\033[0m'
say()  { printf '%s●%s %s\n' "$G" "$N" "$*"; }
warn() { printf '%s●%s %s\n' "$Y" "$N" "$*"; }
step() { printf '\n%s%s%s\n' "$B" "$*" "$N"; }
# spin "label" cmd args...   runs cmd with its output in the log, a spinner and the elapsed time on one line,
#                            then ✓ label (Ns) or ✗ label with the last log lines. Any wait over a few seconds goes through this.
spin() {
  local label="$1"; shift; local t0=$SECONDS rc=0
  if [[ ! -t 1 ]]; then "$@" >>"$LOG" 2>&1 </dev/null || rc=$?; [[ $rc -eq 0 ]] && printf '  ✓ %s (%ds)\n' "$label" $((SECONDS-t0)) || printf '  ✗ %s\n' "$label"; return $rc; fi
  "$@" >>"$LOG" 2>&1 </dev/null & local pid=$! i=0; local frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
  tput civis 2>/dev/null || true
  while kill -0 "$pid" 2>/dev/null; do
    printf '\r  %s%s%s %s %s%ds%s\033[K' "$BL" "${frames:$((i%10)):1}" "$N" "$label" "$D" $((SECONDS-t0)) "$N"; i=$((i+1)); sleep 0.1
  done
  wait "$pid" || rc=$?; tput cnorm 2>/dev/null || true
  if [[ $rc -eq 0 ]]; then printf '\r  %s✓%s %s %s%ds%s\033[K\n' "$G" "$N" "$label" "$D" $((SECONDS-t0)) "$N"
  else printf '\r  %s✗%s %s\033[K\n' "$R" "$N" "$label"; tail -6 "$LOG" | sed 's/^/      /'; fi
  return $rc
}
logo() { printf '%s' "$BL"; cat <<'LOGO'

  ██████╗ ██╗      █████╗ ███╗   ██╗███████╗████████╗ █████╗ ██╗
  ██╔══██╗██║     ██╔══██╗████╗  ██║██╔════╝╚══██╔══╝██╔══██╗██║
  ██████╔╝██║     ███████║██╔██╗ ██║█████╗     ██║   ███████║██║
  ██╔═══╝ ██║     ██╔══██║██║╚██╗██║██╔══╝     ██║   ██╔══██║██║
  ██║     ███████╗██║  ██║██║ ╚████║███████╗   ██║   ██║  ██║██║
  ╚═╝     ╚══════╝╚═╝  ╚═╝╚═╝  ╚═══╝╚══════╝   ╚═╝   ╚═╝  ╚═╝╚═╝
LOGO
printf '%s  %snode · %s%s\n\n' "$N" "$D" "${1:-observe here, decide here, act here}" "$N"; }
# "Something went wrong" on its own is the sentence a tester in Mallorca was left with, twice. A failure
# names what failed, on the first line, before anything else.
fail() {
  printf '\n%s%s%s\n' "$R" "──────────────────────────────────────────────────────────────" "$N"
  printf '%sSet-up stopped.%s %s\n' "$R" "$N" "${FAIL_WHAT:-see the line below}"
  printf '%s%s%s\n' "$R" "──────────────────────────────────────────────────────────────" "$N"
  printf '  %s\n\n' "$*"
  printf '  Full log:  %s\n' "$LOG"
  printf '  Nothing you had is lost. Fix the line above, then run the same command again.\n'
  printf '  Stuck? Open an issue and paste the log:  https://github.com/fabcity/planetai-node/issues\n\n'
  exit 1
}
ask() { # ask VAR "prompt" "default"
  local v="$1" p="$2" d="${3:-}" a
  if [[ -n "$d" ]]; then printf '%s%s%s %s[%s]%s ' "$B" "$p" "$N" "$D" "$d" "$N"; else printf '%s%s%s ' "$B" "$p" "$N"; fi
  read -r a </dev/tty || true
  printf -v "$v" '%s' "${a:-$d}"
}
confirm() { local a=""; printf '%s%s%s %s[Y/n]%s ' "$B" "$1" "$N" "$D" "$N"; read -r a </dev/tty 2>/dev/null || true; [[ -z "$a" || "$a" =~ ^[Yy] ]]; }   # a="" not `local a`: with no tty, read fails and set -u would say "a: unbound variable"
choose() { # choose VAR "prompt" opt1 opt2 ...
  local v="$1" p="$2"; shift 2; local i=1 a
  printf '%s%s%s\n' "$B" "$p" "$N"
  for o in "$@"; do printf '  %s%d%s  %s\n' "$D" "$i" "$N" "$o"; i=$((i+1)); done
  # A typo used to mean option 1, silently. A tester in Menorca was given five places called Mahon, none
  # of them his, and the answer he gave put the node in Senegal with no way back. Show what Enter does,
  # and ask again for anything that is not one of the numbers on screen.
  while :; do
    printf '  %s>%s %s[1]%s ' "$B" "$N" "$D" "$N"; a=""; read -r a </dev/tty || true
    a="${a:-1}"
    [[ "$a" =~ ^[0-9]+$ ]] && [[ "$a" -ge 1 && "$a" -le $# ]] && break
    warn "pick a number between 1 and $#."
  done
  eval "printf -v $v '%s' \"\${$a}\""
}
envget() { { grep -E "^$1=" .env 2>/dev/null || true; } | tail -1 | cut -d= -f2- | sed 's/[[:space:]]*#.*$//' | tr -d '"'"'"' '; }
envset() { # idempotent upsert
  local k="$1" v="$2"
  [[ -f .env ]] || cp .env.example .env
  if grep -q "^${k}=" .env; then
    # the value goes into a sed replacement: `&` would paste the match, `|` would end it, `\` would escape. A CKAN
    # portal list or a JSON layout carries all three. Escape them; the key is always [A-Z_].
    local esc; esc="$(printf '%s' "$v" | sed -e 's/[\\&|]/\\&/g')"
    if [[ "$(uname -s)" == Darwin ]]; then sed -i '' "s|^${k}=.*|${k}=${esc}|" .env; else sed -i "s|^${k}=.*|${k}=${esc}|" .env; fi
  else echo "${k}=${v}" >> .env; fi
}
port() { local p; p="$(envget APP_PORT)"; echo "${p:-8080}"; }
mesh_packets() { api /health | json 'print(d.get("mesh",{}).get("packets",0))' 2>/dev/null || echo 0; }
api() { curl -sf "localhost:$(port)$1" 2>/dev/null; }
# `d` is the parsed stdin. The snippet goes on its own line, so loops and ifs work, not only expressions
# (a `for` after a semicolon is a SyntaxError, and it shipped once).
json() { python3 -c "import sys,json
d=json.load(sys.stdin)
$1"; }

# ---------------------------------------------------------------- geocode: a place name in, coordinates + timezone out
# Open-Meteo first (free, no key, returns the time zone). It knows cities and towns. For neighbourhoods and
# sub-districts it draws a blank, so fall back to OpenStreetMap Nominatim and fetch the time zone separately.
# Nominatim's policy: one request per second and a real User-Agent. We make one, at setup.
urlenc() { python3 -c "import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1]))" "$1"; }
tz_for() { curl -sf "https://api.open-meteo.com/v1/forecast?latitude=$1&longitude=$2&timezone=auto&current=temperature_2m" | json 'print(d.get("timezone","UTC"))' 2>/dev/null || echo UTC; }
geocode() { # prints lines: lat|lon|name|admin|country_code|timezone
  local raw="$1" q
  # "Providencia, Santiago": try the specific part first, the geocoders handle single names best
  if [[ "$raw" == *,* ]]; then
    local first; first="$(geocode "${raw%%,*}" | head -5)"
    if [[ -n "$first" ]]; then
      # keep only hits whose admin/country mention the part after the comma, if any do
      local hint; hint="$(echo "${raw#*,}" | sed 's/^ *//' | tr '[:upper:]' '[:lower:]')"
      local filt; filt="$(echo "$first" | tr '[:upper:]' '[:lower:]' | grep -n "$hint" | cut -d: -f1 | head -3)"
      if [[ -n "$filt" ]]; then for n in $filt; do echo "$first" | sed -n "${n}p"; done; return; fi
      echo "$first"; return
    fi
  fi
  q="$(urlenc "$raw")"
  # BOTH geocoders, every time, with OpenStreetMap's first. Open-Meteo used to be asked alone and its
  # answer returned whenever it had one — which is the failure a tester in Menorca hit: "Mahon" gave five
  # places called Mahon in Senegal, Burkina Faso and the American Midwest, and not the town he lives in.
  # Nominatim answers "Mahon" with Maó, Menorca, first hit; it answers "Menorca" with the island where
  # Open-Meteo answers with the airport, 15 km from him. It knows local and alternate names, so it leads.
  # Two requests at setup, once. Nominatim's policy is one per second and a real User-Agent: we make one.
  local nm; nm="$(curl -sf -A "planetai-node setup (+https://planetai.fab.city)"       "https://nominatim.openstreetmap.org/search?q=${q}&format=json&limit=3&addressdetails=1" | python3 -c '
import sys, json
for x in json.load(sys.stdin)[:3]:
    a = x.get("address", {})
    name = a.get("suburb") or a.get("village") or a.get("town") or a.get("city_district") or a.get("city") or x.get("name","")
    city = a.get("city") or a.get("town") or a.get("municipality") or a.get("county") or a.get("state") or name
    admin = a.get("state") or a.get("county") or ""
    print("|".join([x["lat"], x["lon"], name, admin, (a.get("country_code") or "").upper(), "", city]))' 2>/dev/null || true)"
  local om; om="$(curl -sf "https://geocoding-api.open-meteo.com/v1/search?name=${q}&count=5&language=en&format=json" | python3 -c '
import sys, json
for x in (json.load(sys.stdin).get("results") or [])[:5]:
    print("|".join(str(x.get(k, "")) for k in ("latitude","longitude","name","admin1","country_code","timezone")) + "|" + str(x.get("name","")))' 2>/dev/null || true)"
  # Nominatim carries no time zone, so fill it in per hit. Open-Meteo already has one.
  local filled=""
  if [[ -n "$nm" ]]; then
    while IFS='|' read -r la lo n ad c _ ci; do
      [[ -z "$la" ]] && continue
      filled+="$la|$lo|$n|$ad|$c|$(tz_for "$la" "$lo")|$ci"$'\n'
    done <<<"$nm"
  fi
  # one line per place: Nominatim returns a suburb several times over (three "Sant Martí, Catalunya, ES"
  # for Poblenou), and the two sources overlap on anything either of them knows well. Drop repeats by
  # coordinates, then again by the label the wizard would show, keeping the first — so OpenStreetMap wins.
  printf '%s%s' "$filled" "${om:+$om$'\n'}" \
    | grep -v '^$' \
    | awk -F'|' '{k=sprintf("%.2f|%.2f",$1,$2); if(!seen[k]++) print}' \
    | awk -F'|' '{k=tolower($3"|"$5); if(!seen[k]++) print}' \
    | head -6
}

# ---------------------------------------------------------------- setup
cmd_setup() {
  : > "$LOG"
  exec 3>>"$LOG"
  # An agent, or a script, installs without a terminal: planetai setup --answers node.json
  # {"name":"bayu-2","place":"Kuta Selatan" | "lat":-8.83,"lon":115.16, "kind":"home","sensor":{"sc_user":"x"} | {"sc":"19880"} | {"airgradient":"host"} | {"purpleair":"ip"}}
  if [[ "${1:-}" == "--finish" ]]; then finish_setup; return; fi     # re-entered under the docker group, see below
  if [[ "${1:-}" == "--answers" ]]; then
    local f="${2:?usage: planetai setup --answers file.json}"
    FAIL_WHAT="reading the answers file"; [[ -f "$f" ]] || fail "$f does not exist"
    FAIL_WHAT="reading the answers file — this needs python3, which is not on every Linux"
    have3() { command -v python3 >/dev/null 2>&1; }
    have3 || fail "python3 is not installed, and the CLI needs it to read $f and to look up a place name.
   Debian/Ubuntu:  sudo apt-get update && sudo apt-get install -y python3
   Arch/Omarchy:   sudo pacman -S --noconfirm python
   Fedora:         sudo dnf install -y python3
   Then run the same line again. Nothing here runs pip; the standard library is enough."
    local flags; flags="$(python3 - "$f" <<'PY'
import json, sys, urllib.request, urllib.parse
a = json.load(open(sys.argv[1]))
out = ["--name", a["name"], "--kind", a.get("kind", "home")]
if "lat" in a and "lon" in a:
    out += ["--lat", str(a["lat"]), "--lon", str(a["lon"])]
else:
    q = urllib.parse.quote(a["place"])
    r = json.load(urllib.request.urlopen("https://geocoding-api.open-meteo.com/v1/search?name=%s&count=1" % q, timeout=20))
    hit = (r.get("results") or [None])[0]
    if not hit: sys.exit("could not geocode %r" % a["place"])
    out += ["--lat", str(hit["latitude"]), "--lon", str(hit["longitude"]), "--tz", hit.get("timezone", "UTC")]
s = a.get("sensor") or {}
if "sc_user" in s: out += ["--sc-user", s["sc_user"]]
if "sc" in s: out += ["--sc", str(s["sc"])]
if "airgradient" in s: out += ["--airgradient", s["airgradient"]]
if "purpleair" in s: out += ["--purpleair", s["purpleair"]]
# One flag per LINE, not NUL-joined. bash strips NUL bytes out of a command substitution — it even warns,
# "ignored null byte in input" — so the whole list arrived as one mashed token and every answer in the
# file was silently dropped. No flag here can contain a newline: they are names, numbers and hostnames.
print("\n".join(out))
PY
)" || fail "could not read the answers file"
    local -a arr=(); while IFS= read -r x; do [[ -n "$x" ]] && arr+=("$x"); done <<< "$flags"
    # Silence here meant a node named bayu-2 in Bali, whatever the file said. Never again quietly.
    [[ ${#arr[@]} -ge 4 ]] || fail "could not turn $f into install flags — got: ${arr[*]:-nothing}"
    step "Installing from $f: ${arr[*]}"
    chmod +x install.sh backup.sh update.sh 2>/dev/null || true
    # NOT redirected into the log. This is the headless path — CI, an agent, a provisioning script —
    # and it was the one place still swallowing every named step and elapsed time into a file nobody
    # reads. install.sh reports for itself; let it.
    PLANETAI_INSTALL_LOG="$LOG" ./install.sh --yes "${arr[@]}" || exit 1
    say "installed. planetai status --json for the state; planetai ui for the token."
    return
  fi
  # The code that runs is the code on disk. `planetai setup` executes ./install.sh from THIS folder, so a
  # tester whose install failed keeps re-running the same installer however many fixes have shipped since
  # he downloaded it. Lucas spent a morning on that: three fixes went out, he re-ran `planetai setup`
  # each time, and each time it ran the installer from before any of them.
  version_gap() {
    [[ -d .git ]] && return 0                       # a developer's checkout knows what it is
    local here there
    here="$(cat VERSION 2>/dev/null || echo dev)"
    there="$(curl -fsS --max-time 6 "https://planetai.fab.city/node0/get/VERSION" 2>/dev/null | tr -d '[:space:]')"
    [[ -z "$there" || -z "$here" || "$here" == "$there" ]] && return 0
    echo
    warn "this folder holds $here. The published version is $there."
    echo "  What runs here is what is in this folder, so a fix released after you downloaded it is not in it."
    echo "  One line replaces the code and keeps your settings, your data and your answers:"
    echo
    echo "    curl -fsSL planetai.fab.city/install | bash"
    echo
    if [[ -t 1 ]] && ( : </dev/tty ) 2>/dev/null && confirm "  Do that now?"; then
      exec bash -c "$(curl -fsSL https://planetai.fab.city/install)"
    fi
    warn "carrying on with $here. If it fails the same way as before, that is why."
  }
  version_gap

  # Every environment check happens here, before question 1. A tester who answers four questions and only then
  # hears that this machine cannot run a node has spent his evening for nothing — which is what happened on
  # 7 September 2026, twice, because platform detection lived inside install.sh.
  #   0  go   ·   1  something the tester can fix, each with its line   ·   2  this machine is below the floor
  if [[ "${PLANETAI_PREFLIGHT_OK:-0}" != 1 ]]; then
    local pf=0; bash tools/preflight.sh || pf=$?     # `; pf=$?` would abort under set -e before it is read
    [[ $pf -eq 2 ]] && exit 0            # a verdict, not a crash: nothing here says "something went wrong"
    [[ $pf -eq 0 ]] || exit 1
  fi

  # a node is "installed" when its containers exist. A .env with a name but no containers is an install that did
  # not finish (Docker not reachable at the time, the image failed to build): ask the questions again.
  # "This machine already runs a node" was decided by .env alone once docker was unreachable, so a machine
  # with NO container runtime at all was told it was running one — and then offered an update, which ran
  # backup.sh, which needs docker. Lucas got `./backup.sh: line 44: docker: command not found` on a laptop
  # where preflight had just said, correctly, "runtime none found". A node is running when its containers
  # are: anything else is an install that stopped somewhere, and the way out of that is to continue it.
  local node_running=0
  if docker info >/dev/null 2>&1 && [[ -n "$(docker compose ps -q 2>/dev/null)" ]]; then node_running=1; fi
  if [[ -f .env ]] && [[ -n "$(envget NODE_NAME)" ]] && [[ $node_running -eq 0 ]]; then
    # The answers were written to .env before anything heavy ran, so a re-run has them. It used to say
    # "starting again" and ask all four a second time, which is what a tester meets after any failed install.
    if docker info >/dev/null 2>&1; then
      step "A set-up here did not finish, but your answers were saved."
    else
      step "A set-up here did not finish — there is no container runtime yet. Your answers were saved."
    fi
    printf '   name        %s\n   place       %s (%s, %s)\n   time zone   %s\n   city key    %s\n' \
      "$(envget NODE_NAME)" "$(envget NODE_CITY)" "$(envget NODE_LAT)" "$(envget NODE_LON)" "$(envget NODE_TZ)" "$(envget NODE_CITY)"
    echo
    if confirm "Continue with these?"; then
      step "Installing"
      chmod +x install.sh backup.sh update.sh 2>/dev/null || true
      PLANETAI_INSTALL_LOG="$LOG" ./install.sh --yes || exit 1
      finish_setup; return
    fi
    # After an install that failed more than once, starting clean is often the shortest way out — and
    # until now there was no way to do it that anyone could be sure of.
    local next
    choose next "   Then what?" \
      "Ask the four questions again" \
      "Remove this half-finished node and start clean"
    case "$next" in
      Remove*) cmd_remove; return;;
      *) say "starting the questions again.";;
    esac
  elif [[ -f .env ]] && [[ -n "$(envget NODE_NAME)" ]]; then
    step "This machine already runs a node: $(envget NODE_NAME) ($(envget NODE_CITY), $(envget NODE_LAT), $(envget NODE_LON))"
    local what
    choose what "What would you like to do?" \
      "Update it to the latest version (keeps everything)" \
      "Reconfigure it (asks the questions again; your data stays)" \
      "Nothing, just make sure it is running" \
      "Remove it from this machine (asks twice; the readings go)"
    case "$what" in
      Update*)      cmd_update; return;;
      Reconfigure*) ;;
      Remove*)      cmd_remove; return;;
      *)            docker compose up -d >>"$LOG" 2>&1; cmd_doctor; return;;
    esac
  fi
  # Four questions need somewhere to ask them. With no controlling terminal — a CI job, a provisioning
  # script, `ssh host "curl ... | bash"` — `read </dev/tty` fails, the place loop takes the empty answer,
  # `continue`s, and asks again forever. It printed "Place" until someone killed it. Say the headless way
  # instead. (`curl | bash` in a real terminal is fine: stdin is the pipe, /dev/tty is still the terminal.)
  if ! ( : </dev/tty ) 2>/dev/null; then
    warn "there is no terminal here to ask you four questions."
    echo
    echo "  Install without one, with the answers in a file:"
    echo
    echo '    cat > node.json <<'"'"'JSON'"'"
    echo '    {"name": "my-node", "place": "Palma de Mallorca", "kind": "home", "sensor": {}}'
    echo "    JSON"
    echo "    planetai setup --answers node.json"
    echo
    echo "  place can be a town or a neighbourhood; use \"lat\" and \"lon\" instead if you know them."
    echo "  kind is home, business, community or district. sensor may be {} , or one of:"
    echo '    {"sc": "19880"}   {"sc_user": "you"}   {"airgradient": "host"}   {"purpleair": "ip"}'
    return 1
  fi

  step "Let's set up a node."
  echo "  Four questions. Everything else is detected or defaulted, and you can change it later in .env."
  echo

  # 1. name
  local name; ask name "1. A short name for this node (lowercase, dashes)" "$(hostname -s | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-\n' '-')"
  name="$(echo "$name" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-\n' '-')"

  # 2. place → coordinates, timezone, city key, and whether Bali's archive applies
  step "2. Where is it?"
  echo "  Type a place: a neighbourhood, town or city. I'll find the coordinates and time zone."
  local lat lon tz city cc place hits pick
  while :; do
    ask place "   Place" ""
    [[ -z "$place" ]] && continue
    hits="$(geocode "$place" 2>>"$LOG" || true)"
    if [[ -z "$hits" ]]; then warn "nothing found for '$place'. Try a nearby town, or a bigger place, or paste 'lat,lon'."
      if [[ "$place" =~ ^-?[0-9.]+,\ ?-?[0-9.]+$ ]]; then lat="${place%%,*}"; lon="$(echo "${place##*,}" | tr -d ' ')"; tz="UTC"; city="node"; cc=""; break; fi
      continue; fi
    local n; n=$(echo "$hits" | wc -l | tr -d ' ')
    if [[ "$n" -gt 1 ]]; then
      local opts=(); while IFS='|' read -r la lo nm ad c t ci; do opts+=("$nm, $ad, $c  ($t)"); done <<<"$hits"
      # The way out. Without it a list with none of your places in it is a dead end, and the tester in
      # Menorca killed the terminal to escape one — losing the answers he had already given.
      local NONE="None of these — let me type the place differently"
      choose pick "   Which one?" "${opts[@]}" "$NONE"
      if [[ "$pick" == "$NONE" ]]; then
        echo "   Try the local spelling, a nearby town, or paste 'lat,lon' — e.g. 39.89,4.27"
        continue
      fi
      local idx=1; for o in "${opts[@]}"; do [[ "$o" == "$pick" ]] && break; idx=$((idx+1)); done
      hits="$(echo "$hits" | sed -n "${idx}p")"
    fi
    local ci; IFS='|' read -r lat lon nm ad cc tz ci <<<"$hits"
    city="$(echo "${ci:-$nm}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9\n' '-' | sed 's/-*$//')"
    say "$nm, $ad, $cc  →  $lat, $lon  ·  $tz"
    # A single hit used to be taken without asking. "Menorca" returned exactly one — Menorca Airport,
    # 15 km from the tester who typed it — and the node was placed there silently.
    confirm "   Is that the right place?" || { echo "   Type it differently: the local spelling, a nearby town, or 'lat,lon'."; continue; }
    break
  done
  # pilot keys join existing Index rows; anything else stays as its own place
  # the four Index pilots, by bounding box: a neighbourhood inside one files under the pilot's key
  local pilot; pilot="$(python3 -c '
import sys; lat, lon = float(sys.argv[1]), float(sys.argv[2])
boxes = {"bali": (-9.2, -8.0, 114.4, 115.8), "barcelona": (41.25, 41.55, 1.9, 2.35),
         "boston": (42.2, 42.5, -71.3, -70.9), "santiago": (-33.75, -33.2, -70.95, -70.4)}
print(next((k for k, (a, b, c, d) in boxes.items() if a < lat < b and c < lon < d), ""))' "$lat" "$lon")"
  [[ -n "$pilot" ]] && city="$pilot"
  local bad=0; [[ "$pilot" == bali ]] && bad=1
  [[ $bad -eq 1 ]] && say "that's Bali: the island air archive (Bali Air Dispatch) will be used as your outdoor reference." \
                    || say "outdoor reference: the global CAMS model at your coordinates (no key, works everywhere)."

  # 3. what kind of node — decides defaults, not the Index scale (a house is still a Community-scale observation)
  step "3. What is this node for?"
  local kind_label kind
  choose kind_label "   Pick the closest." \
    "A home: my household, my sensors, alerts to us. Home Assistant if we use it." \
    "A business: a shop, hotel, school or clinic. Alerts to staff, a monthly summary." \
    "A community or lab node: shared by a neighbourhood or a fab lab; other nodes may report to it." \
    "A district or region node: it aggregates other nodes (advanced)."
  case "$kind_label" in A\ home*) kind=home;; A\ business*) kind=business;; A\ community*) kind=community;; *) kind=district;; esac

  # 4. sensor
  step "4. Do you have a sensor?"
  local sensor sc ag pa indoor=0        # not `kind`: that already holds home|business|community|district from question 3
  choose sensor "   Pick one. You can add more later." \
    "None yet. Start with the global models and add hardware when I have it." \
    "Smart Citizen kit (I have the number from its smartcitizen.me URL)" \
    "AirGradient on my WiFi" \
    "PurpleAir on my WiFi"
  case "$sensor" in
    Smart*) ask sc "   Kit number" ""; [[ "$sc" =~ ^[0-9]+$ ]] || fail "a Smart Citizen kit number is digits only, e.g. 19880" ;;
    AirGradient*) ask ag "   Its hostname or IP (on the device's sticker, or in your router)" "airgradient_XXXXXX.local"
                  confirm "   Is it indoors?" && indoor=1 ;;
    PurpleAir*)   ask pa "   Its IP address (from your router; the .local name is unreliable)" ""
                  confirm "   Is it indoors?" && indoor=1 ;;
  esac

  # summary
  step "Here's the plan"
  printf '   name        %s\n   place       %s (%s, %s)\n   time zone   %s\n   city key    %s\n   sensor      %s\n   outside     %s\n' \
    "$name" "${nm:-$place}" "$lat" "$lon" "$tz" "$city" "${sc:+Smart Citizen $sc}${ag:+AirGradient $ag}${pa:+PurpleAir $pa}${sc:-${ag:-${pa:-none, models only}}}" \
    "$([[ $bad -eq 1 ]] && echo 'Bali Air Dispatch + CAMS' || echo 'CAMS model')"
  echo
  confirm "Install with these?" || { echo "ok, nothing changed."; exit 0; }

  # The answers go to .env now, before a single image is pulled. install.sh writes the same values again; the
  # point is that a failure anywhere below this line leaves them on disk, so a re-run can offer them back.
  envset NODE_NAME "$name"; envset NODE_LAT "$lat"; envset NODE_LON "$lon"
  envset NODE_TZ "$tz"; envset NODE_CITY "$city"; envset NODE_KIND "$kind"
  [[ -n "${sc:-}" ]] && envset SC_DEVICES "$sc"; [[ -n "${ag:-}" ]] && envset AIRGRADIENT_HOSTS "$ag"
  [[ -n "${pa:-}" ]] && envset PURPLEAIR_HOSTS "$pa"; [[ $indoor -eq 1 ]] && envset SENSOR_INDOOR 1
  [[ $bad -eq 0 ]] && envset BAD_ENABLED 0

  # install
  step "Installing"
  local flags=(--name "$name" --lat "$lat" --lon "$lon")
  [[ -n "$pilot" ]] && flags+=(--preset "$pilot")     # the pilot's portal and references; the coordinates typed here still win
  [[ -n "${sc:-}" ]] && flags+=(--sc "$sc"); [[ -n "${ag:-}" ]] && flags+=(--airgradient "$ag"); [[ -n "${pa:-}" ]] && flags+=(--purpleair "$pa")
  [[ $indoor -eq 1 ]] && flags+=(--indoor); [[ $bad -eq 0 ]] && flags+=(--no-bad)
  chmod +x install.sh backup.sh update.sh 2>/dev/null || true
  # NOT wrapped in spin(): install.sh prints named steps with elapsed time, and hiding them behind one
  # spinner line is precisely what left a tester watching "building the node" for four minutes and then
  # reading "Something went wrong."
  PLANETAI_INSTALL_LOG="$LOG" ./install.sh "${flags[@]}" || exit 1
  envset NODE_TZ "$tz"; envset NODE_CITY "$city"; envset NODE_KIND "$kind"
  [[ "$kind" == district ]] && envset NODE_SCALE city
  # on a Linux box that had no Docker a minute ago, install.sh ran under the new docker group (sg) but this shell
  # still lacks it: finish the same way, or the next compose call dies with "permission denied ... docker.sock"
  if ! docker info >/dev/null 2>&1 && grep -qw docker <<< "$(id -nG "$USER")" && command -v sg >/dev/null; then
    exec sg docker -c "$(printf '%q ' "$0" setup --finish)"
  fi
  finish_setup
}

# the last steps of setup: restart with the settings, wait, doctor, the green screen. Also the target of the sg re-exec.
finish_setup() {
  spin "starting with your settings" docker compose up -d --force-recreate app || fail "the app container did not restart with your settings"
  spin "waiting for the first answer" bash -c 'for i in $(seq 1 30); do curl -sf "http://localhost:$(grep ^APP_PORT= .env | cut -d= -f2 | sed "s/[[:space:]]*#.*$//" | tr -d " " || echo 8080)/health" >/dev/null && exit 0; sleep 1; done; exit 1' || true
  api /health >/dev/null || fail "the node is not answering on port $(port). Look at: planetai logs"
  cmd_doctor quiet || echo "  The crosses above are normal on a new node: Telegram is the next step, and the first backup runs tonight."

  what_next
}

# the screen after an install: one obvious door to the dashboard, one to Telegram, one to stay here
what_next() {
  local p; p="$(port)"; local ip; ip="$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}')"
  local host; host="$(hostname -s 2>/dev/null || hostname).local"; local tok; tok="$(envget ADMIN_TOKEN)"
  printf '\n%s┌──────────────────────────────────────────────────────────────────────┐%s\n' "$G" "$N"
  printf '%s│%s  %s● Your node is running.%s                                             %s│%s\n' "$G" "$N" "$B" "$N" "$G" "$N"
  printf '%s└──────────────────────────────────────────────────────────────────────┘%s\n\n' "$G" "$N"
  printf '  %sThe dashboard%s\n' "$B" "$N"
  printf '    on this machine     %shttp://localhost:%s%s\n' "$BL" "$p" "$N"
  [[ -n "$ip" ]] && printf '    from your phone     %shttp://%s:%s%s   (same WiFi)\n' "$BL" "$ip" "$p" "$N"
  printf '    settings token      %s%s%s   (planetai ui shows it again)\n\n' "$D" "${tok:-not set yet}" "$N"
  printf '  %sThis is an alpha.%s Things will break; tell us what happened, what helped and what did not: %sinfo@fab.city%s\n\n' "$Y" "$N" "$B" "$N"
  printf '  %sIn the terminal%s\n' "$B" "$N"
  printf '    %splanetai%s             every command, one line each\n' "$BL" "$N"
  printf '    %splanetai telegram%s    alerts on your phone, two minutes\n' "$BL" "$N"
  printf '    %splanetai status%s      what it has read so far\n\n' "$BL" "$N"
  # under `curl ... | bash` stdin is the pipe, so test the terminal itself, not stdin: the [o]/[t] prompt never showed for
  # anyone who used the documented install line
  if [[ -t 1 ]] && ( : </dev/tty ) 2>/dev/null; then
    printf '  What now?  %s[o]%s open the dashboard   %s[t]%s connect Telegram   %s[Enter]%s stay in the terminal\n  ' "$B" "$N" "$B" "$N" "$B" "$N"
    local k; IFS= read -r -n1 k </dev/tty || k=""; echo
    case "$k" in
      o|O) (open "http://localhost:$p" 2>/dev/null || xdg-open "http://localhost:$p" 2>/dev/null || echo "  open http://localhost:$p in a browser") ; echo "  Opened. Settings are behind the token above.";;
      t|T) cmd_telegram;;
      *)   echo; "$0" help | head -30;;
    esac
  fi
}

# ---------------------------------------------------------------- status / doctor / logs
cmd_status() {
  if [[ "${1:-}" == "--json" ]]; then
    python3 -c "import json,urllib.request
p='$(port)'
h=json.load(urllib.request.urlopen('http://localhost:'+p+'/health',timeout=10)); h['rho']=json.load(urllib.request.urlopen('http://localhost:'+p+'/rho',timeout=10)); print(json.dumps(h))"
    return
  fi
  local h; h="$(api /health)" || { warn "the node isn't answering on port $(port). Try: planetai doctor"; exit 1; }
  echo "$h" | json '
print("  node      %s   %s   schema %s" % (d["node"], d.get("version","?"), d.get("schema","?")))
print("  up        %dh %dm   polls %s   readings %s" % (d["uptime_s"]//3600, d["uptime_s"]%3600//60, d["polls"], d["ingested"]))
print("  last poll %s" % (d.get("last_poll") or "not yet"))
print("  errors    %s" % (d.get("last_error") or "none"))'
  api /sensors | json '
own=[s for s in d if s["local"]]; ref=[s for s in d if not s["local"]]
print(("  sensors   %d of yours: " % len(own)) + ", ".join(s["sensor_id"] for s in own) if own else "  sensors   none of yours yet (models only)")
print(("  reference %d: " % len(ref)) + ", ".join(s["sensor_id"] for s in ref[:4]) + (" ..." if len(ref)>4 else ""))' 2>/dev/null || true
  api /alerts | json 'print("  alerts    %d so far" % len(d)); [print("            "+a["ts"][:16].replace("T"," ")+"  "+a["text"][:80]) for a in d[:3]]' 2>/dev/null || true
  api /rho | json 'print("  rho       %s  (%s/%s act-level alerts answered, 30d)" % (d["rho"] if d["rho"] is not None else "not yet measured", d["acted"], d["alerts_act"]))' 2>/dev/null || true
}

cmd_doctor() {
  local quiet="${1:-}" ok=1 p; p="$(port)"; local JSON=0; [[ "$quiet" == "--json" ]] && { JSON=1; quiet=""; }
  local rows=""
  chk() {
    local pass=1; eval "$2" >/dev/null 2>&1 || pass=0
    if [[ $JSON -eq 1 ]]; then
      local fix="null"; [[ $pass -eq 1 ]] || fix="\"$(sed 's/"/\\"/g' <<< "$3")\""
      rows+="$(printf '{"check":"%s","ok":%s,"fix":%s}' "$1" "$([[ $pass -eq 1 ]] && echo true || echo false)" "$fix"),"
    elif [[ $pass -eq 1 ]]; then printf '  %s✓%s %s\n' "$G" "$N" "$1"; else printf '  %s✗%s %s\n' "$R" "$N" "$1"; printf '      %s→ %s%s\n' "$D" "$3" "$N"; fi
    [[ $pass -eq 1 ]] || ok=0
  }
  [[ -z "$quiet" && $JSON -eq 0 ]] && step "Doctor"
  chk "docker is running"        "docker info"                                          "start OrbStack / Docker Desktop, or on Linux: sudo systemctl start docker"
  chk "containers are up"        "[ \$(docker compose ps -q | wc -l) -ge 2 ]"           "planetai start"
  chk "database answers"         "docker compose exec -T db pg_isready -U planetai"     "planetai logs db"
  chk "node answers on :$p"      "curl -sf localhost:$p/health"                         "planetai logs   (if the port is taken: set APP_PORT in .env, then planetai restart)"
  # /health answers even when every database call fails; the schema field then carries the pre-0.4 text. Seen after a
  # reinstall over a leftover volume: pg_isready happy, the app locked out, the install's doctor all green.
  chk "app logs in to the database" "h=\"\$(curl -sf localhost:$p/health)\"; [[ -n \"\$h\" ]] && ! grep -q '\"schema\": *\"pre-0.4' <<< \"\$h\""   "the app cannot use the database (planetai logs shows 'password authentication failed'): the POSTGRES_PASSWORD in .env does not match the database volume, usually after a reinstall over an earlier node's volume. Keep the data: restore the earlier .env. Start clean: planetai stop && docker volume rm planetai_db && planetai start"
  chk "coordinates set"          "grep -qE '^NODE_LAT=-?[0-9]' .env"                    "planetai setup"
  chk ".env has no stray spaces" "! grep -qE '^[A-Z_]+=[[:space:]]+[^[:space:]]' .env"   "a space after = makes the shell run the value, and a `#` after it hands the container the comment: grep -nE '^[A-Z_]+= +' .env"
  chk "backup destination mounted" "mounted \"\$(envget BACKUP_DIR || echo ./backups)\""   "the NAS or drive in BACKUP_DIR is not mounted; tonight's backup will refuse. Mount it, or: planetai storage set backups <dir>"
  chk "a backup in the last 2 days" "[[ -n \"\$(find \"\$(envget BACKUP_DIR || echo ./backups)\" -name '*.sql.gz' -mtime -2 2>/dev/null)\" ]]"   "planetai backup — and check cron: crontab -l | grep backup"
  chk "telegram connected"       "grep -qE '^TELEGRAM_BOT_TOKEN=.+' .env && grep -qE '^TELEGRAM_CHAT_IDS=.+' .env"  "planetai telegram   (alerts go to the log until then)"
  chk "a backup exists"          "ls backups/*.sql.gz"                                  "planetai backup   (then check the line below)"
  chk "nightly backup scheduled" "grep -q planetai-backup <<< \"\$(crontab -l 2>/dev/null)\""   "no cron entry. Add it: (crontab -l 2>/dev/null; echo '17 3 * * * cd $PWD && ./backup.sh >/dev/null 2>&1 # planetai-backup') | crontab -   (macOS: give cron Full Disk Access first)"
  # the disk the node lives on: the database volume and the backups share it by default; when it fills, Postgres stops
  local freek; freek="$(df -Pk . 2>/dev/null | awk 'NR==2{print $4}')"; freek="${freek:-0}"
  chk "over 1 GB free on this disk" "[ \"$freek\" -gt 1048576 ]"   "$(( freek / 1024 )) MB free where the node lives. The database and tonight's backup fail when it fills: free space here, or move the backups: planetai storage set backups <dir on another disk>"
  case ",$(envget COMPOSE_PROFILES)," in *,mqtt,*)
    chk "broker up :1883"        "nc -z localhost 1883"                                 "planetai logs mosquitto"
    chk "mesh packets arriving"  "[ \$(mesh_packets) -gt 0 ]"                              "gateway not uplinking yet: planetai meshtastic prints the settings";; esac
  case ",$(envget COMPOSE_PROFILES)," in *,reticulum,*)
    chk "reticulum bridge up"    "curl -sf localhost:4243/health"                       "planetai logs reticulum";; esac
  if [[ $JSON -eq 1 ]]; then printf '{"ok":%s,"checks":[%s]}\n' "$([[ $ok -eq 1 ]] && echo true || echo false)" "${rows%,}"; return $(( 1 - ok )); fi
  [[ $ok -eq 1 ]] && { [[ -z "$quiet" ]] && say "all good"; return 0; }
  [[ -z "$quiet" ]] && warn "fix the marked lines, then run planetai doctor again"
  return 1
}

cmd_logs() { docker compose logs -f --tail=80 "${1:-app}"; }

# ---------------------------------------------------------------- telegram, guided
cmd_telegram() {
  step "Connect Telegram"
  echo "  1. In Telegram, message @BotFather and send:  /newbot"
  echo "     Give it any name, and a username ending in 'bot'. It replies with a token like  7123456789:AAF…"
  echo
  local tok; ask tok "  2. Paste the token here" ""
  [[ "$tok" =~ ^[0-9]+:[A-Za-z0-9_-]{30,}$ ]] || fail "that doesn't look like a bot token (digits, a colon, then a long string)"
  local me; me="$(curl -sf "https://api.telegram.org/bot${tok}/getMe" | json 'print(d["result"]["username"])' 2>/dev/null)" || fail "Telegram rejected that token. Copy it again from @BotFather."
  say "token works. Your bot is @${me}"
  echo
  echo "  3. Open a chat with @${me} (or add it to a group and make it an admin), and send it any message."
  printf '     Waiting for your message'
  local chat=""; for i in $(seq 1 60); do
    # the newest update is not always a message (adding the bot to a group is a my_chat_member event; an edit is
    # edited_message), and the old check only looked at the last one, so the wait never ended. Newest message wins.
    chat="$(curl -sf "https://api.telegram.org/bot${tok}/getUpdates" | json '
import sys
u=d.get("result",[])
m=[x for x in u if any(k in x for k in ("message","edited_message","channel_post"))]
x=m[-1] if m else {}
print((x.get("message") or x.get("edited_message") or x.get("channel_post") or {}).get("chat",{}).get("id",""))' 2>/dev/null || true)"
    [[ -n "$chat" ]] && break; printf '.'; sleep 2
  done; echo
  [[ -n "$chat" ]] || fail "no message arrived in two minutes. Send one to @${me}, then run planetai telegram again."
  say "found your chat: $chat"
  envset TELEGRAM_BOT_TOKEN "$tok"; envset TELEGRAM_CHAT_IDS "$chat"
  # the dashboard may hold its own values for these, and those win over .env. Write the same values there too, so the
  # terminal and the dashboard never disagree about which bot this node talks to.
  runtime_set TELEGRAM_BOT_TOKEN "$tok" TELEGRAM_CHAT_IDS "$chat" || warn "the node is not answering, so only .env was written; planetai restart makes it take effect"
  curl -sf "https://api.telegram.org/bot${tok}/sendMessage" -d chat_id="$chat" -d text="$(envget NODE_NAME) is connected. Alerts will arrive here." >/dev/null && say "sent you a hello"
  docker compose up -d --force-recreate app >/dev/null 2>&1
  say "the node is restarting with Telegram on. Try:  planetai test-alert"
}

# ---------------------------------------------------------------- test alert: a temporary pack, not an edit to your rules
cmd_test_alert() {
  step "Test alert"
  # a unique rule id per run: the cooldown check matches on rule_id, so a fixed id would suppress every test
  # after the first one for the length of its cooldown (this bit us: a 69-day cooldown from an earlier run).
  local rid="hello-$(date +%s)"
  trap 'rm -rf packs/_test' EXIT      # Ctrl-C while waiting must not leave a rule that fires every minute
  mkdir -p packs/_test
  cat > packs/_test/pack.yaml <<'Y'
id: _test
name: Test alert
description: Temporary. Created by `planetai test-alert`, removed when it fires.
kind: data
Y
  cat > packs/_test/rules.yml <<Y
- id: ${rid}
  level: act
  cooldown_minutes: 1
  sql: SELECT 'node' AS sensor_id, now()::text AS at
  message:
    en: "Test alert from your node. If you can read this, the whole path works: rule to message to you. Record it with \`planetai act <id>\`."
    id: "Alert uji dari node Anda. Jika Anda membaca ini, seluruh jalur berfungsi. Catat dengan \`planetai act <id>\`."
Y
  echo "  A rule that always fires has been added. The node checks rules every minute."
  printf '  Waiting'
  local before after id=""; before="$(api /alerts | json 'print(len(d))')"
  for i in $(seq 1 45); do
    after="$(api /alerts | json 'print(len(d))' 2>/dev/null || echo "$before")"
    if [[ "$after" -gt "$before" ]]; then id="$(api /alerts | json 'print(d[0].get("id","?"))' 2>/dev/null || echo "?")"; break; fi
    printf '.'; sleep 2
  done; echo
  rm -rf packs/_test
  [[ -n "$id" ]] || fail "no alert fired in 90 seconds. Is the node up? planetai doctor"
  say "it fired. Alert #$id is in the log$( grep -qE '^TELEGRAM_BOT_TOKEN=.+' .env && echo ' and on your phone')."
  echo
  printf '  Now close the loop, which is the part the Index measures:\n    %splanetai act %s%s\n' "$B" "$id" "$N"
}

# ---------------------------------------------------------------- the report: the node's one scheduled message
cmd_report() {
  local sub="${1:-now}" val="${2:-}"
  case "$sub" in
    now|"")
      local tok; tok="$(envget ADMIN_TOKEN)"; [[ -n "$tok" ]] || fail "no ADMIN_TOKEN in .env; run planetai ui"
      curl -sf -m 300 -X POST "http://localhost:$(port)/report/now" -H "Authorization: Bearer $tok" -H 'content-type: application/json' \
        | json 'print(); print(d["text"]); print(); print("  written by %s, sent." % d["rung"])' \
        || fail "the node did not write a report; planetai logs shows why"
      ;;
    every)
      [[ "$val" =~ ^(3|4|6|8|12|24)$ ]] || fail "usage: planetai report every 3|4|6|8|24 (hours between reports; each divides 24)"
      runtime_set REPORT_EVERY "$val" || fail "could not reach the node's settings; is it running?"
      api /report/latest >/dev/null
      say "a report every $val hours from $(envget REPORT_ANCHOR || echo 6):00 local. Live within 20 seconds; no restart."
      ;;
    at)
      [[ "$val" =~ ^([0-9]|1[0-9]|2[0-3])$ ]] || fail "usage: planetai report at <hour 0-23> (the local hour the rhythm starts from)"
      runtime_set REPORT_ANCHOR "$val" || fail "could not reach the node's settings; is it running?"
      say "the rhythm starts at $val:00 local. Live within 20 seconds; no restart."
      ;;
    level)
      [[ "$val" =~ ^(act|warn|info)$ ]] || fail "usage: planetai report level act|warn|info
   act  = only when something needs doing. The warns wait for the next report.
   warn = also when something changed.
   info = everything the node notices."
      runtime_set ALERT_LEVEL "$val" || fail "could not reach the node's settings; is it running?"
      case "$val" in
        act)  say "between reports you will hear only what needs doing. Everything else is on the dashboard and in the next report.";;
        warn) say "between reports you will also hear when something changed.";;
        info) say "between reports you will hear everything the node notices. This is a lot.";;
      esac
      ;;
    last|latest)
      api /report/latest | json '
if not d.get("text"): print("  no report yet; the first one lands at the next due hour")
else:
    print(); print(d["text"]); print()
    print("  %s \u00b7 %s hours \u00b7 written by %s%s" % (d["ts"][:16].replace("T"," "), d["window_hours"], d["rung"], "" if d["sent"] else " \u00b7 HELD for quiet hours, folded into the next one"))'
      ;;
    *) fail "usage: planetai report [now | last | every <hours> | at <hour> | level act|warn|info]";;
  esac
}


cmd_act() {
  local id="${1:-}"; [[ "$id" =~ ^[0-9]+$ ]] || { echo "usage: planetai act <alert id> [note]"; exit 1; }
  local note="${2:-acted}"
  local body; body="$(python3 -c 'import json,sys; print(json.dumps({"alert_id": int(sys.argv[1]), "stage": "acted", "actor": sys.argv[2], "note": sys.argv[3]}))' "$id" "$(whoami)" "$note")"
  curl -sf -X POST "localhost:$(port)/actions" -H 'content-type: application/json' -d "$body" >/dev/null && say "recorded: you acted on #$id" || { warn "the node did not record it (is alert #$id real? planetai status shows the ids)"; return 1; }
  api /rho | json 'print("  rho is now %s  (%s/%s alerts answered, median %s min)" % (d["rho"], d["acted"], d["alerts_act"], d["median_minutes"]))'
}


# ---------------------------------------------------------------- mesh: reach this node from anywhere, no open ports
# Tailscale (WireGuard overlay). One command per machine. The control plane is Tailscale's; the exit is Headscale,
# which uses the same client and is parked in SPEC §6 with its trigger. On a headless Mac use the Homebrew daemon,
# not the App Store app: the daemon runs without anyone logged in, which is what a cupboard node needs.
cmd_mesh() {
  local sub="${1:-up}"
  case "$sub" in
    status)
      command -v tailscale >/dev/null || { warn "tailscale is not installed. Run: planetai mesh"; return 1; }
      tailscale status 2>/dev/null | head -12; return;;
    down) sudo tailscale down && say "left the mesh (node keeps running on the LAN)"; return;;
    up) ;;
    *) echo "usage: planetai mesh [up|status|down]"; return 1;;
  esac
  step "Join the mesh"
  echo "  After this, the node is reachable by name from any of your devices, wherever they are, with no ports"
  echo "  opened on any router. You may be asked to log in to Tailscale in a browser, once."
  echo
  local name; name="$(envget NODE_NAME)"; name="${name:-planetai}"
  if ! command -v tailscale >/dev/null; then
    say "installing tailscale"
    case "$(uname -s)" in
      Darwin)
        command -v brew >/dev/null || fail "Homebrew is needed to install the Tailscale daemon on macOS: https://brew.sh"
        brew install tailscale >>"$LOG" 2>&1 || fail "brew install tailscale failed; see $LOG"
        sudo brew services start tailscale >>"$LOG" 2>&1 || true ;;
      Linux)
        curl -fsSL https://tailscale.com/install.sh | sh >>"$LOG" 2>&1 || fail "tailscale install failed; see $LOG" ;;
    esac
  fi
  say "logging in. If a URL appears below, open it in a browser and approve this machine."
  # --ssh (Tailscale SSH, no keys to manage) is a Linux-only server feature; on macOS it is silently ignored and
  # plain sshd answers instead, so only ask for it where it works.
  SSH_FLAG=""; [[ "$(uname -s)" == Linux ]] && SSH_FLAG="--ssh"
  sudo tailscale up $SSH_FLAG --hostname "$name" --accept-dns=true ${TS_AUTHKEY:+--authkey "$TS_AUTHKEY"} </dev/tty 2>&1 | tee -a "$LOG"
  local ip dns
  ip="$(tailscale ip -4 2>/dev/null | head -1)"
  dns="$(tailscale status --json 2>/dev/null | json 'print(d["Self"]["DNSName"].rstrip("."))' 2>/dev/null || echo "$name")"
  [[ -n "$ip" ]] || fail "tailscale did not come up. Try: planetai mesh status"
  envset MESH_NAME "$dns"
  say "on the mesh as ${B}${dns}${N} (${ip})"
  echo
  echo "  From any other device on your tailnet:"
  if [[ "$(uname -s)" == Linux ]]; then
    printf '    ssh %s                        %s# a shell on the node, no keys needed (Tailscale SSH)%s\n' "$name" "$D" "$N"
  else
    printf '    ssh <user>@%s   %s# macOS: turn on System Settings > General > Sharing > Remote Login first;%s\n' "$dns" "$D" "$N"
    printf '                                  %s# Tailscale SSH has no macOS server, so this is ordinary sshd over the tailnet%s\n' "$D" "$N"
  fi
  printf '    curl %s:%s/health     %s# its API%s\n' "$dns" "$(port)" "$D" "$N"
  printf '    ssh %s planetai status        %s# run any planetai command remotely%s\n' "$name" "$D" "$N"
  echo
  echo "  A child node reports to this one with:  PARENT_API_URL=http://${dns}:$(port)"
  echo "  Unattended joins for future nodes:      TS_AUTHKEY=tskey-auth-… planetai mesh"
}


# ---------------------------------------------------------------- meshtastic: LoRa sensors and alerts, via the gateway's MQTT
lan_ip() { case "$(uname -s)" in Darwin) ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null;; *) hostname -I 2>/dev/null | awk '{print $1}';; esac; }
profiles_add() { local cur; cur="$(envget COMPOSE_PROFILES)"; case ",$cur," in *",$1,"*) ;; *) envset COMPOSE_PROFILES "${cur:+$cur,}$1";; esac; }
cmd_meshtastic() {
  step "Meshtastic"
  echo "  A LoRa mesh reaches sensors and phones where there is no WiFi. One radio with WiFi is the gateway: it"
  echo "  uplinks the mesh to a broker on this node, and can send alerts back out. This sets the node side up and"
  echo "  tells you exactly what to type into the gateway."
  echo
  local user="planetai" pass; pass="$(envget MQTT_PASS)"
  if [[ -z "$pass" ]]; then
    pass="$(openssl rand -hex 12 2>/dev/null || head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    envset MQTT_HOST mosquitto; envset MQTT_USER "$user"; envset MQTT_PASS "$pass"
  fi
  profiles_add mqtt
  say "creating the broker user"
  # mosquitto_passwd runs in a throwaway container as root, writing straight into the host's config dir.
  # (Running it inside the compose service fails: that service mounts the config read-only, on purpose.)
  docker run --rm --user 0 -v "$PWD/config/mosquitto:/m" eclipse-mosquitto:2 \
    sh -c "rm -f /m/passwd && mosquitto_passwd -b -c /m/passwd '$user' '$pass' && chmod 644 /m/passwd" >>"$LOG" 2>&1 \
    || fail "could not write the broker password file; see $LOG"
  [[ -s config/mosquitto/passwd ]] || fail "password file is empty after mosquitto_passwd; see $LOG"
  say "starting the broker and restarting the node with MQTT on"
  docker compose up -d >>"$LOG" 2>&1 && docker compose up -d --force-recreate app >>"$LOG" 2>&1 || fail "compose failed; see $LOG"
  local ip; ip="$(lan_ip)"; [[ -n "$ip" ]] || ip="<this machine LAN IP>"
  local region="EU_868"; case "$(envget NODE_CITY)" in bali) region="SG_923 (AS923, the band Indonesia allocates)";; boston) region="US";; santiago) region="LORA_24 or check local allocation";; esac
  step "Now the gateway radio (the ESP32 one), in the Meshtastic app"
  cat <<T
   Radio configuration
     LoRa      → Region:                ${region}
   Module configuration
     MQTT      → Enabled:               on
                 Address:               ${ip}:1883
                 Username:              ${user}
                 Password:              ${pass}
                 Encryption enabled:    off       (the broker is yours; encrypted uplink hides readings from the node)
                 JSON output enabled:   ON        (without this the node cannot read the packets)
                 Root topic:            msh
   Channels  → your channel → Uplink enabled: on   Downlink enabled: on (needed for alerts back to the mesh)
   Position  → on radios with GPS, broadcast on, so sensors report where they are
   Telemetry → Environment metrics: on, and the update interval you want (15 min is a sane default)

   The field radios (Tracker L1 with a BME680/HM3301 on the Grove port) need only: same channel, telemetry on.
T
  echo
  printf '  Waiting for the first packet from the mesh (up to 3 minutes)'
  local got=""; for i in $(seq 1 90); do
    got="$(api /health | json 'print(d.get("mesh",{}).get("packets",0))' 2>/dev/null || echo 0)"
    [[ "${got:-0}" -gt 0 ]] && break; printf '.'; sleep 2
  done; echo
  if [[ "${got:-0}" -gt 0 ]]; then
    say "packets arriving. Sensors seen so far:"; cmd_sensors | grep -i mesh || echo "   (nodeinfo/position only so far; telemetry follows at the radio's interval)"
    echo
    echo "  To send act-level alerts back over the mesh: set MESH_ALERTS=1 and MESH_GATEWAY_NODE_NUM=<gateway node number,"
    echo "  decimal — in the app under the gateway's node details> in .env, then planetai restart."
    echo "  Indoor mesh sensors: MESH_INDOOR_NODES=!abcd1234,... in .env."
  else
    warn "nothing yet. The usual reasons: JSON output off on the gateway; wrong address (this Mac is ${ip}); gateway not on"
    warn "this WiFi; a firewall blocking 1883. Watch with:  planetai logs mosquitto    and    planetai logs"
  fi
}

# ---------------------------------------------------------------- reticulum: an LXMF address for the node
cmd_reticulum() {
  step "Reticulum"
  echo "  Gives this node an address on a Reticulum network: encrypted, works over TCP (LAN or tailnet) today and over"
  echo "  a LoRa RNode when one is plugged in. People message it from Sideband; 'act <id>' closes an alert's loop;"
  echo "  alerts go out to the addresses you list."
  echo
  [[ -f config/reticulum/config ]] || cp config/reticulum/config.tpl config/reticulum/config
  envset RETICULUM_URL http://reticulum:4243
  profiles_add reticulum
  say "building and starting the bridge (first time: a minute)"
  docker compose up -d --build reticulum >>"$LOG" 2>&1 && docker compose up -d --force-recreate app >>"$LOG" 2>&1 || fail "compose failed; see $LOG"
  local addr=""; for i in $(seq 1 30); do addr="$(curl -sf localhost:4243/health 2>/dev/null | json 'print(d["address"])' 2>/dev/null || true)"; [[ -n "$addr" ]] && break; sleep 2; done
  [[ -n "$addr" ]] || fail "the bridge did not come up:  planetai logs reticulum"
  say "this node's LXMF address:  ${B}${addr}${N}"
  echo
  echo "  In Sideband (phone or desktop):"
  echo "    Connectivity → add a TCP Client interface → host $(lan_ip) (or $(envget MESH_NAME)) port 4242"
  echo "    Conversations → new → paste the address above. Send:  act 3   to record you acted on alert #3."
  echo
  echo "  To receive alerts in Sideband: copy your own LXMF address from Sideband's settings into .env as"
  echo "    RETICULUM_ALERT_DESTINATIONS=<hash>[,<hash>]   then planetai restart."
  echo "  For LoRa: plug in an RNode, uncomment its block in config/reticulum/config, pass the device in compose (Linux)."
}


# ---------------------------------------------------------------- home assistant: the node's sensors and alerts as HA entities
cmd_homeassistant() {
  step "Home Assistant"
  echo "  The node publishes every local sensor and its alerts over MQTT in Home Assistant's discovery format."
  echo "  HA creates the entities itself; you build automations there (purifier on when indoor PM2.5 > 35, and so on)."
  echo "  We publish, HA acts. The node never addresses a device."
  echo
  case ",$(envget COMPOSE_PROFILES)," in *,mqtt,*) ;; *)
    say "no broker yet: setting one up (this is the same broker the Meshtastic gateway uses)"
    local user="planetai" pass; pass="$(openssl rand -hex 12)"
    envset MQTT_HOST mosquitto; envset MQTT_USER "$user"; envset MQTT_PASS "$pass"; profiles_add mqtt
    docker run --rm --user 0 -v "$PWD/config/mosquitto:/m" eclipse-mosquitto:2 \
      sh -c "rm -f /m/passwd && mosquitto_passwd -b -c /m/passwd '$user' '$pass' && chmod 644 /m/passwd" >>"$LOG" 2>&1 \
      || fail "could not create the broker user; see $LOG";;
  esac
  envset HA_DISCOVERY 1
  docker compose up -d >>"$LOG" 2>&1 && docker compose up -d --force-recreate app >>"$LOG" 2>&1 || fail "compose failed; see $LOG"
  local ip; ip="$(lan_ip)"
  say "publishing. Entities appear in HA within one poll (5 min)."
  echo
  echo "  In Home Assistant: Settings → Devices & services → Add integration → MQTT"
  printf '     Broker    %s\n     Port      1883\n     Username  %s\n     Password  %s\n' "${ip:-<this machine LAN IP>}" "$(envget MQTT_USER)" "$(envget MQTT_PASS)"
  echo "  Discovery is on by default in HA's MQTT integration. Devices appear as 'PLANETAI node' with one device per"
  echo "  sensor and a 'latest alert' text sensor on the node itself (attributes: level, alert_id)."
  echo
  echo "  If HA already runs its own broker, point this node at it instead: MQTT_HOST=<ha-broker-ip> MQTT_USER/MQTT_PASS in .env,"
  echo "  planetai restart. Then the Meshtastic gateway should uplink to that broker too."
}


# ---------------------------------------------------------------- packs: what is loaded, and code-pack dependencies
# `pip:` lines from pack.yaml, with grep and sed. The node's Python is Apple's, with no PyYAML, and nothing else
# in this CLI needs a third-party library — a tool that reports what is installed must not itself need installing.
# Handles `pip: [a, b]` and a block list of `- a` lines.
# `env:` lines from pack.yaml, same awk approach as pack_pips (no PyYAML on a node).
pack_envs() {
  awk '
    /^env:[[:space:]]*$/ { inenv=1; next }
    inenv && /^[[:space:]]*-[[:space:]]*/ { s=$0; sub(/^[[:space:]]*-[[:space:]]*/,"",s); gsub(/^"|"$/,"",s); if(s!="") print s; next }
    inenv && /^[^[:space:]-]/ { inenv=0 }
  ' packs/*/pack.yaml 2>/dev/null
}

pack_pips() {
  awk '
    /^pip:[[:space:]]*\[/ { s=$0; sub(/^pip:[[:space:]]*\[/,"",s); sub(/\].*$/,"",s); n=split(s,a,","); for(i=1;i<=n;i++){ gsub(/[[:space:]"'"'"']/,"",a[i]); if(a[i]!="") print a[i] } ; next }
    /^pip:[[:space:]]*$/ { inpip=1; next }
    inpip && /^[[:space:]]*-[[:space:]]*/ { s=$0; sub(/^[[:space:]]*-[[:space:]]*/,"",s); gsub(/[[:space:]"'"'"']/,"",s); if(s!="") print s; next }
    inpip { inpip=0 }
  ' packs/*/pack.yaml 2>/dev/null | sort -u
}

cmd_packs() {
  # `planetai packs` lists; `planetai packs install` writes (.env keys, the image). A listing that rebuilt the image and
  # appended to .env surprised the first tester who only wanted to see what was loaded (6 Sep 2026).
  if [[ "${1:-}" == "install" ]]; then packs_install; return; fi
  step "Packs"
  local loaded; loaded="$(api /packs || true)"
  if [[ -z "$loaded" ]]; then
    warn "the node is not answering on port $(port) — the list below is what is on disk, not what is running."
    warn "check with: planetai doctor"
    ls -d packs/*/ 2>/dev/null | sed 's|packs/||;s|/||' | sed 's/^/    /'
  else
    echo "  loaded now:"
    printf '%s' "$loaded" | json 'for p in d: print("    %-16s %-5s %s" % (p["id"], p["kind"], (p.get("description") or "").replace(chr(10)," ")[:70]))'
  fi
  echo
  # what `install` would do, said rather than done
  local reqs; reqs="$(pack_pips)"; local missing=0
  while IFS= read -r line; do [[ -z "$line" || "$line" == \#* ]] && continue; grep -q "^${line%%=*}=" .env 2>/dev/null || missing=$((missing+1)); done < <(pack_envs)
  if [[ -n "$reqs" && "$(cat app/requirements-packs.txt 2>/dev/null)" != "$reqs" ]] || [[ $missing -gt 0 ]]; then
    echo "  Code packs here declare Python dependencies or settings that are not installed yet."
    echo "  To add them to .env and the image (a rebuild, a minute or two):  planetai packs install"
  fi
}

packs_install() {
  step "Packs: install"
  # settings a pack needs, declared as `env:` in its pack.yaml. A `#` line explains the setting under it and
  # travels only if that setting is actually added — otherwise the file collects orphan comments.
  local added=0 pending=""
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    if [[ "$line" == \#* ]]; then pending="$line"; continue; fi
    local k="${line%%=*}"
    if grep -q "^${k}=" .env 2>/dev/null; then pending=""; continue; fi
    [[ $added -eq 0 ]] && printf '\n# ---- pack settings, added by `planetai packs install` on %s ----\n' "$(date +%F)" >> .env
    [[ -n "$pending" ]] && echo "$pending" >> .env
    echo "$line" >> .env; echo "    + ${k}"; pending=""; added=$((added+1))
  done < <(pack_envs)
  [[ $added -gt 0 ]] && warn "${added} pack setting(s) added to .env — fill them in, then planetai restart" || true

  # pip: lists from every pack folder present. A rebuild installs for all of them, enabled or not; cheap and simple.
  local reqs; reqs="$(pack_pips)"
  if [[ -z "$reqs" ]]; then say "no code pack declares Python dependencies; nothing to install"; return; fi
  if [[ "$(cat app/requirements-packs.txt 2>/dev/null)" == "$reqs" ]]; then
    say "code-pack dependencies already recorded: $(echo "$reqs" | paste -sd' ' -). If the image predates them: planetai restart"
    return
  fi
  echo "$reqs" > app/requirements-packs.txt
  say "installing into the image: $(echo "$reqs" | paste -sd' ' -)  (rebuild, a minute or two)"
  docker compose build app >>"$LOG" 2>&1 && docker compose up -d --force-recreate app >>"$LOG" 2>&1 || fail "rebuild failed; see $LOG"
  say "done. Code packs also need PACKS_ALLOW_CODE=1 in .env to run. Read their adapter.py first."
}


# ---------------------------------------------------------------- run a script a pack ships
# Packs can carry scripts as well as rules: things you ask for rather than things that happen on a schedule.
# They run inside the app container, where the pack's dependencies are, and write to out/ on the host.
cmd_run() {
  local pack="${1:-}" script="${2:-}"; shift 2 2>/dev/null || true
  if [[ -z "$pack" || -z "$script" ]]; then
    echo "usage: planetai run <pack> <script> [args...]"
    echo
    echo "available:"
    for f in packs/*/*.py; do
      local p s; p="$(basename "$(dirname "$f")")"; s="$(basename "$f" .py)"
      [[ "$s" == "adapter" ]] && continue
      # the first line of the module docstring, wherever the docstring starts; a file without one shows nothing,
      # not its first import line
      local desc; desc="$(awk '
        !found && /^[[:space:]]*(r|u)?("""|\047\047\047)/ { found=1; sub(/^[[:space:]]*(r|u)?("""|\047\047\047)[[:space:]]*/, ""); sub(/("""|\047\047\047).*$/, ""); if ($0 != "") { print; exit }; next }
        found && NF { print; exit }' "$f" | cut -c1-58)"
      printf '  planetai run %-14s %-12s %s\n' "$p" "$s" "$desc"
    done
    return 1
  fi
  [[ -f "packs/$pack/$script.py" ]] || fail "packs/$pack/$script.py does not exist"
  docker compose exec -T -e PACK_OUT=/app/out app python "/app/packs/$pack/$script.py" "$@"
}


# ---------------------------------------------------------------- the GUI
cmd_ui() {
  step "Dashboard"
  if [[ -z "$(envget ADMIN_TOKEN)" ]]; then
    local tok; tok="$(openssl rand -hex 16 2>/dev/null || head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    [[ -n "$tok" ]] || fail "could not generate a token"
    envset ADMIN_TOKEN "$tok"; docker compose up -d --force-recreate app >>"$LOG" 2>&1; say "created an admin token"
  fi
  [[ -n "$(envget ADMIN_TOKEN)" ]] || fail "ADMIN_TOKEN is empty in .env even after trying to set it — check that .env is writable"
  if [[ -z "$(envget ACT_TOKEN)" ]]; then
    local atok; atok="$(openssl rand -hex 16 2>/dev/null || head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    [[ -n "$atok" ]] && { envset ACT_TOKEN "$atok"; docker compose up -d --force-recreate app >>"$LOG" 2>&1; say "created a token for closing a loop"; }
  fi
  local ip; ip="$(lan_ip)"; local p; p="$(port)"
  echo "  On this machine:      http://localhost:${p}/"
  [[ -n "$ip" ]] && echo "  On your network:      http://${ip}:${p}/"
  [[ -n "$(envget MESH_NAME)" ]] && echo "  On the tailnet:       http://$(envget MESH_NAME):${p}/"
  echo "  On a small display:   add  ?kiosk=1  — big numbers only, refreshes every 30 s"
  echo
  local lvl; lvl="$(envget SHARE_LEVEL)"; lvl="${lvl:-off}"
  if [[ "$lvl" == "off" ]]; then
    echo "  SHARE_LEVEL is off, so a screen on your network gets the dashboard and the node's status and no readings."
    echo "  To let every screen in the house read them without a token, set SHARE_LEVEL to open in Set up below."
  else
    echo "  SHARE_LEVEL is $lvl: anything on your network can read the sensors. Writing still needs a token."
  fi
  echo "  The plan card needs a token at every level: it is the shape of your building."
  echo
  echo "  Set up (sources, alerts, packs, keys) asks for the admin token once per browser:"
  echo
  printf '     %s%s%s\n' "$B" "$(envget ADMIN_TOKEN)" "$N"
  echo
  echo "  Anyone with it can change what the node reads and where it sends alerts. Treat it like a password."
  echo
  echo "  For a NAS that collects backups — read-only, fetches dumps and nothing else:"
  echo
  printf '     %s%s%s\n' "$B" "$(envget BACKUP_TOKEN)" "$N"
  echo
  echo "  For closing a loop from a phone — recording that someone acted — the weaker token, which cannot read a"
  echo "  secret or change a setting:"
  echo
  printf '     %s%s%s\n' "$B" "$(envget ACT_TOKEN)" "$N"
}


# ---------------------------------------------------------------- storage: where the data is, and where copies go
mounted() { case "$1" in /Volumes/*|/mnt/*|/media/*) grep -q " on $(echo "$1" | cut -d/ -f1-3) " <<< "$(mount)";; *) return 0;; esac; }
cmd_storage() {
  local sub="${1:-}"
  if [[ "$sub" == "set" ]]; then
    local what="${2:-}" val="${3:-}"
    case "$what" in
      backups)  [[ -n "$val" ]] || fail "usage: planetai storage set backups <dir>"
                mounted "$val" || fail "$val is on a drive that is not mounted right now. Mount it first, so I can check it is real."
                mkdir -p "$val" 2>/dev/null && [[ -w "$val" ]] || fail "$val is not writable"
                envset BACKUP_DIR "$val"; say "backups will go to $val from tonight. Run  planetai backup  to try it now.";;
      remote)   envset BACKUP_REMOTE "$val"; command -v rclone >/dev/null || warn "rclone is not installed: brew install rclone (macOS) or apt install rclone. Then: rclone config"
                say "off-machine copies to '$val' after each backup${val:+ (rclone remote:path)}";;
      keep)     envset BACKUP_KEEP "$val"; say "keeping $val days of dumps";;
      data)     fail "the live database stays on a local disk. Set DATA_DIR in .env to a path on another INTERNAL disk or partition,
   then: planetai backup && planetai stop && edit .env && planetai start && planetai restore <latest dump>.
   Never a NAS or a USB drive over the network: Postgres needs fsync and locking those filesystems do not honour.";;
      *)        fail "usage: planetai storage set backups|remote|keep <value>";;
    esac; return
  fi
  step "Storage"
  local dbsize; dbsize="$(docker compose exec -T db psql -U planetai -tAc "select pg_size_pretty(pg_database_size('planetai'))" 2>/dev/null || echo '?')"
  local rows; rows="$(docker compose exec -T db psql -U planetai -tAc "select count(*) from readings" 2>/dev/null || echo '?')"
  local where; where="$(envget DATA_DIR)"; where="${where:-Docker volume planetai_pgdata (this machine)}"
  local bdir; bdir="$(envget BACKUP_DIR)"; bdir="${bdir:-./backups}"
  echo "  Live database      $where"
  echo "                     $dbsize, $rows readings. Local disk by design; a NAS would corrupt it."
  echo
  printf '  Backups            %s' "$bdir"
  if ! mounted "$bdir"; then printf '   %s✗ NOT MOUNTED — tonight'"'"'s backup will refuse to run%s\n' "$R" "$N";
  elif [[ -d "$bdir" ]]; then local last n; last="$(ls -t "$bdir"/*.sql.gz 2>/dev/null | head -1 || true)"; shopt -s nullglob; local dumps=("$bdir"/*.sql.gz); n=${#dumps[@]}; shopt -u nullglob
    printf '   %s dumps, keep %s days\n' "$n" "$(envget BACKUP_KEEP || true)"; [[ -n "$last" ]] && echo "                     last: $(basename "$last") ($(du -h "$last" | cut -f1))" || printf '                     %sno backup yet%s\n' "$Y" "$N"
    [[ -f "$bdir/LAST_OK" ]] && echo "                     last run OK at $(cat "$bdir/LAST_OK")"
  else printf '   %s(does not exist yet)%s\n' "$Y" "$N"; fi
  echo "                     nightly at 03:17 by cron; on demand:  planetai backup"
  echo
  local rem; rem="$(envget BACKUP_REMOTE)"
  if [[ -n "$rem" ]]; then echo "  Off-machine copy   $rem  (rclone, after each backup)$(command -v rclone >/dev/null || printf '  %s✗ rclone not installed%s' "$R" "$N")"
  else echo "  Off-machine copy   none.  planetai storage set remote b2:bucket/node   (any rclone backend: S3, B2, R2, Drive, SFTP, WebDAV…)"; fi
  echo
  # count with a glob, not `ls | wc`: with no exports yet ls fails, pipefail fails the assignment, set -e ends the function
  local ex="exports/$(envget NODE_NAME)"; local nex=0; shopt -s nullglob; local exfiles=("$ex"/*.json); nex=${#exfiles[@]}; shopt -u nullglob
  echo "  Open-data exports  $ex   $nex day(s). Hourly means, cells, alerts, rho. Never raw. CC BY 4.0."
  if [[ "$(envget IPFS_PUBLISH)" == "1" ]]; then local ncid=0; [[ -f "$ex/CIDS.txt" ]] && ncid="$(wc -l < "$ex/CIDS.txt" | tr -d ' ')"; echo "  IPFS               publishing. $ncid CID(s) in $ex/CIDS.txt"
  else echo "  IPFS               off.  planetai ipfs   to publish each day's export to the commons"; fi
  echo
  local btok shown; btok="$(envget BACKUP_TOKEN)"
  # Not the token itself: this is the command somebody pastes into an issue when their backups stop.
  [[ -n "$btok" ]] && shown="set  ·  planetai ui prints it" || shown="not set — planetai update writes one"
  echo "  Pulled by a NAS    GET /backups and /backups/<file>, with the read-only backup token:"
  printf '                     %s\n' "$shown"
  echo
  echo "  Change:  planetai storage set backups /Volumes/NAS/planetai    set remote r2:planetai/$(envget NODE_NAME)    set keep 60"
}


# ---------------------------------------------------------------- remove
# A node is a folder, two containers and a volume. Taking it off a machine was three commands in
# START_HERE that nobody could be sure they had got right, and after a failed install the only advice was
# "start over" with no way to do it. This is that way, and it asks twice because the volume holds
# readings nobody else has.
# The compose project name is the folder's basename unless COMPOSE_PROJECT_NAME says otherwise, and
# every node lives in ~/planetai — so on any one machine all nodes share one project and one set of
# volume names. That is why a leftover volume is not bad luck: it is the default.
proj()  { printf '%s' "${COMPOSE_PROJECT_NAME:-$(basename "$PWD")}"; }
# Every volume this node owns. By compose's own label first, then by name, because a volume created by
# an older compose may carry no label — and grep matching nothing must not take the caller down.
# Takes the project name, because the checks that matter run AFTER the folder is deleted, and by then
# basename "$PWD" is "/".
node_volumes() { local pj="${1:-$(proj)}"
  { { docker volume ls -q --filter "label=com.docker.compose.project=$pj" 2>/dev/null || true
      docker volume ls -q 2>/dev/null | grep -E "^${pj}_(db|mosquitto|reticulum|ipfsdata)$" || true
    } | sort -u; } || true
}
# The names a node's volumes WOULD have, computable with no daemon at all. When docker is unreachable
# we cannot list what exists, but we can still tell somebody exactly what to delete later — deleting
# the folder is what otherwise leaves that data with nothing left on the machine that names it.
node_volume_names() { local pj="${1:-$(proj)}" v; for v in db mosquitto reticulum ipfsdata; do printf '%s_%s\n' "$pj" "$v"; done; }

cmd_remove() {
  local keep=0; [[ "${1:-}" == "--keep-data" ]] && keep=1
  local name; name="$(envget NODE_NAME)"; name="${name:-this node}"
  logo "removing $name"

  # What will go, counted before anything is touched.
  local rows="unknown" vols="" cron=0 link=0 daemon=0
  local PROJ; PROJ="$(proj)"; local GONE="$PWD"
  if docker info >/dev/null 2>&1; then
    daemon=1
    rows="$(docker compose exec -T db psql -tAqU planetai -c 'SELECT count(*) FROM readings' planetai </dev/null 2>/dev/null | tr -d '[:space:]' || true)"
    rows="${rows:-0}"
    vols="$(node_volumes "$PROJ")"
  fi
  grep -q planetai-backup <<< "$(crontab -l 2>/dev/null)" && cron=1
  [[ -L "$HOME/.local/bin/planetai" ]] && link=1

  step "This will remove, from this machine:"
  printf '   containers      %s\n' "$(docker compose ps -q 2>/dev/null | wc -l | tr -d ' ' || true) running or stopped"
  if [[ $keep -eq 1 ]]; then
    printf '   database        %skept%s — the volume and every reading stay\n' "$G" "$N"
  else
    printf '   database        %sdeleted%s — %s readings, and no copy of them anywhere else\n' "$R" "$N" "$rows"
  fi
  printf '   this folder     %s\n' "$PWD"
  if [[ $daemon -eq 1 ]]; then
    if [[ -n "$vols" ]]; then
      printf '   docker volumes  %s\n' "$(tr '\n' ' ' <<< "$vols")"
    else
      printf '   docker volumes  none left to remove\n'
    fi
  else
    # The case that orphaned Lucas's data: no daemon, so `docker compose down -v` never ran, the folder
    # went anyway, and four volumes were left with no compose file left on the machine to name them.
    printf '\n   %sdocker is not running here, so the containers and the database volume cannot be\n' "$Y"
    printf '   removed now. Everything else goes. These are the names to delete once it starts:%s\n' "$N"
    node_volume_names "$PROJ" | sed 's/^/     docker volume rm /'
    printf '   %sStart docker and run this again instead, if you can — then nothing is left behind.%s\n' "$D" "$N"
  fi
  [[ $cron -eq 1 ]] && printf '   nightly backup  the crontab line that runs backup.sh\n'
  [[ $link -eq 1 ]] && printf '   the command     %s/.local/bin/planetai\n' "$HOME"
  local nb; nb="$(ls backups/*.sql.gz 2>/dev/null | wc -l | tr -d ' ' || true)"; nb="${nb:-0}"
  if [[ "$nb" != "0" ]]; then
    printf '\n   %s%s backup(s) in %s/backups are inside the folder and go with it.%s\n' "$Y" "$nb" "$PWD" "$N"
    printf '   %sCopy them out first if you want them: cp %s/backups/*.sql.gz ~/%s\n' "$D" "$PWD" "$N"
  fi
  echo

  ( : </dev/tty ) 2>/dev/null || { warn "no terminal here, so nothing was removed. Run this where you can answer it."; return 1; }
  confirm "Remove it?" || { say "nothing was removed."; return 0; }
  local typed=""
  printf '%sType the node'"'"'s name to confirm — %s%s%s%s: ' "$B" "$R" "$name" "$N" "$B"; printf '%s' "$N"
  read -r typed </dev/tty || true
  [[ "$typed" == "$name" ]] || { warn "that is not \"$name\". Nothing was removed."; return 1; }

  step "Removing"
  if [[ $daemon -eq 1 ]]; then
    if [[ $keep -eq 1 ]]; then
      spin "stopping the containers, keeping the data" docker compose down || true
    else
      spin "stopping the containers and deleting the volumes" docker compose down -v || true
      # `docker compose down -v` used to be the only thing that ever deleted a volume, behind a `|| true`
      # that swallowed its failure. It removes what the compose file declares, which misses a volume left
      # by an older layout, and does nothing at all when it fails. Delete by name too, and notice.
      local v left=""
      for v in $(node_volumes "$PROJ"); do
        docker volume rm "$v" >/dev/null 2>&1 || left="$left $v"
      done
      [[ -z "$left" ]] || warn "these volumes would not delete:$left — something is still using them."
    fi
  else
    warn "docker is not running, so the containers and volumes are being left as they are"
  fi
  if [[ $cron -eq 1 ]]; then
    crontab -l 2>/dev/null | grep -v planetai-backup | crontab - 2>/dev/null && say "nightly backup unscheduled"
  fi
  [[ $link -eq 1 ]] && { rm -f "$HOME/.local/bin/planetai"; say "removed the planetai command"; }

  # The folder last, from outside it, so nothing is deleting the ground it stands on.
  cd / || return 1
  rm -rf "$GONE" && say "removed $GONE"

  # It used to end by asserting "gone. Nothing of this node is left" — printed unconditionally, after a
  # `down -v` that may never have run. Measure instead, now that the folder is out of the way.
  step "Checking that it is actually gone"
  local rest="" n
  n="$(docker ps -aq --filter "label=com.docker.compose.project=$PROJ" 2>/dev/null | wc -l | tr -d ' ' || true)"
  [[ "${n:-0}" == 0 ]] || rest="$rest$n container(s) still here:  docker rm -f \$(docker ps -aq --filter label=com.docker.compose.project=$PROJ)\n"
  if [[ $keep -eq 0 ]]; then
    local vl; vl="$(node_volumes "$PROJ" | tr '\n' ' ' || true)"
    [[ -z "${vl// /}" ]] || rest="${rest}volumes still holding data:  docker volume rm ${vl% }\n"
  fi
  [[ ! -d "$GONE" ]] || rest="${rest}the folder is still there:  rm -rf $GONE\n"
  [[ ! -L "$HOME/.local/bin/planetai" ]] || rest="${rest}the command is still linked:  rm $HOME/.local/bin/planetai\n"
  grep -q planetai-backup <<< "$(crontab -l 2>/dev/null)" && rest="${rest}the crontab line is still there:  crontab -e\n"

  echo
  if [[ $daemon -eq 0 ]]; then
    # Docker was unreachable, so `down -v` never ran and nothing here can list what survived. Saying
    # "no volumes" would be a guess dressed as a check — which is what it used to do.
    warn "the folder, the command and the crontab line are gone. The containers and the database"
    printf '   volume cannot be checked or removed from here, because docker is not running. Once it\n'
    printf '   starts, this finishes the job:\n\n'
    node_volume_names "$PROJ" | sed 's/^/     docker volume rm /'
    printf '     docker rm -f $(docker ps -aq --filter label=com.docker.compose.project=%s)\n' "$PROJ"
    printf '\n   %sThis matters: a fresh install into the same folder re-attaches a leftover volume and\n' "$Y"
    printf '   comes up carrying the old node\047s readings and name.%s\n' "$N"
  elif [[ -z "$rest" ]]; then
    say "checked: no containers, no volumes, no folder, no command. Only the PATH line in your shell profile is left, and it is harmless."
  else
    warn "removed what it could, but this is still on the machine:"
    printf '%b' "$rest" | sed 's/^/     /'
    printf '\n   %sThis matters: a fresh install into the same folder re-attaches a leftover volume and\n' "$Y"
    printf '   comes up carrying the old node\047s readings and name.%s\n' "$N"
  fi
  echo "   To run one here again:  curl -fsSL planetai.fab.city/install | bash"
}

cmd_restore() {
  local f="${1:-}"; [[ -n "$f" ]] || { echo "usage: planetai restore <dump.sql.gz>"; echo; ls -t "$(envget BACKUP_DIR || echo ./backups)"/*.sql.gz 2>/dev/null | head -5 | sed 's/^/  /'; return 1; }
  [[ -f "$f" ]] || fail "$f does not exist"
  step "Restore"
  echo "  This replaces the live database with $(basename "$f"). Everything since that dump is lost."
  read -r -p "  Type the node name to confirm: " ans </dev/tty; [[ "$ans" == "$(envget NODE_NAME)" ]] || fail "cancelled"
  ./backup.sh >/dev/null 2>&1 && say "safety backup taken first" || warn "safety backup failed; continuing because you asked"
  docker compose stop app >>"$LOG" 2>&1
  docker compose exec -T db psql -U planetai -d postgres -c "DROP DATABASE planetai" -c "CREATE DATABASE planetai" >>"$LOG" 2>&1 || fail "could not recreate the database; see $LOG"
  gunzip -c "$f" | docker compose exec -T db psql -U planetai -d planetai >>"$LOG" 2>&1 || fail "restore failed; see $LOG"
  docker compose exec -T db psql -U planetai -d planetai -v ON_ERROR_STOP=0 -f - < init.sql >>"$LOG" 2>&1 || true
  docker compose start app >>"$LOG" 2>&1
  say "restored. $(docker compose exec -T db psql -U planetai -tAc 'select count(*) from readings') readings."
  # dumps carry no settings rows (backup.sh excludes them so tokens never travel): the node runs on .env until re-set
  echo "  Dashboard settings and anything saved from Set up are not in a dump, on purpose: the node now uses .env."
  echo "  Telegram: if it was connected from the dashboard rather than the terminal, run  planetai telegram  once more."
}

cmd_ipfs() {
  step "IPFS"
  echo "  Publishes each day's export — hourly means, cells, alerts, rho; never raw readings — to IPFS, where anyone can"
  echo "  fetch it by its content hash. This is the commons layer. The database and its backups never go here."
  echo
  profiles_add ipfs; envset IPFS_PUBLISH 1; envset EXPORT_ENABLED 1
  docker compose up -d ipfs >>"$LOG" 2>&1 || fail "could not start the ipfs container; see $LOG"
  sleep 4
  local pid; pid="$(docker compose exec -T ipfs ipfs id -f '<id>' 2>/dev/null || true)"
  [[ -n "$pid" ]] && say "node id $pid" || warn "ipfs is starting; check again in a minute with: docker compose logs ipfs"
  echo
  echo "  Tonight's backup adds yesterday's export and records the CID in exports/$(envget NODE_NAME)/CIDS.txt."
  echo "  Persistence: a CID lives while some node pins it. This node pins its own; for durability beyond this machine,"
  echo "  set a pinning service (Pinata, web3.storage, Filebase) in rclone as a remote, or ask a partner node to pin yours."
  echo "  Publish now instead of waiting:  planetai backup"
}


# ---------------------------------------------------------------- agents: the node as tools over MCP
cmd_agent() {
  step "Agents"
  local p; p="$(port)"; local tok; tok="$(envget ADMIN_TOKEN)"; local dns; dns="$(envget MESH_NAME)"
  echo "  The node is an MCP server at /mcp. Any agent that speaks MCP (Claude Desktop, Claude Code, Codex, a local model"
  echo "  with an MCP client) gets nineteen tools: status, health_check, sensors, context, readings, report_latest,"
  echo "  report_now, report_bundle, history,"
  echo "  alerts, act, settings_get, settings_set, packs, cells, series, export_day, run_pack_script, maintenance."
  echo "  Writes record the agent's name (X-Agent)."
  echo
  echo "  Local (this machine):    http://localhost:${p}/mcp"
  [[ -n "$dns" ]] && echo "  From the tailnet:        http://${dns}:${p}/mcp"
  echo "  Header on every call:    Authorization: Bearer ${tok:-<ADMIN_TOKEN>}"
  echo
  echo "  Claude Desktop / Claude Code (mcp.json or claude_desktop_config.json):"
  cat <<JSON
    {"mcpServers": {"planetai-$(envget NODE_NAME)": {"type": "http",
      "url": "http://${dns:-<node>}:${p}/mcp",
      "headers": {"Authorization": "Bearer ${tok:-<ADMIN_TOKEN>}", "X-Agent": "tomas-claude"}}}}
JSON
  echo
  echo "  A local model on this machine (Ollama with an MCP client, e.g. mcphost or oterm): same URL with localhost."
  echo "  An agent with a shell here also has:  planetai status --json · doctor --json · sensors --json · cells --json"
  echo "  and  planetai setup --answers node.json  to install without a terminal. Read AGENTS.md first; it is written for them."
}


# ---------------------------------------------------------------- a model on this machine that runs the node
cmd_agent_local() {
  step "A model on this machine"
  echo "  Ollama here, a small tool-calling model, the node's tools, and your Telegram bot to talk to it. No cloud, no key."
  echo "  A stronger model is used whenever one is reachable: set it on the dashboard's Model page (or in .env)."
  echo
  if ! command -v ollama >/dev/null; then
    say "installing Ollama"
    case "$(uname -s)" in
      Darwin) if command -v brew >/dev/null; then brew install --quiet ollama >>"$LOG" 2>&1 || fail "brew install ollama failed; see $LOG"
              else fail "install Ollama from https://ollama.com/download, open it once, then run this again"; fi;;
      Linux)  curl -fsSL https://ollama.com/install.sh | sh >>"$LOG" 2>&1 || fail "ollama install failed; see $LOG";;
      *) fail "install Ollama from https://ollama.com/download first";;
    esac
  fi
  # run it as a service so it comes back after a reboot, like everything else on the node
  if ! curl -sf --max-time 3 http://127.0.0.1:11434/api/tags >/dev/null; then
    if [[ "$(uname -s)" == Darwin ]] && command -v brew >/dev/null && brew list ollama >/dev/null 2>&1; then
      brew services start ollama >>"$LOG" 2>&1 || (nohup ollama serve >>"$LOG" 2>&1 &)
    elif command -v systemctl >/dev/null; then sudo systemctl enable --now ollama >>"$LOG" 2>&1 || (nohup ollama serve >>"$LOG" 2>&1 &)
    else (nohup ollama serve >>"$LOG" 2>&1 &); fi
    for i in $(seq 1 15); do curl -sf --max-time 3 http://127.0.0.1:11434/api/tags >/dev/null && break; sleep 2; done
  fi
  curl -sf --max-time 5 http://127.0.0.1:11434/api/tags >/dev/null || fail "Ollama is not answering on 11434 after 30 s. Try: brew services start ollama  (or open the Ollama app), then run this again"
  local mem model; mem="$(sysctl -n hw.memsize 2>/dev/null || awk '/MemTotal/{print $2*1024}' /proc/meminfo)"; mem=$((mem/1073741824))
  model="$(envget AGENT_MODEL)"; [[ -n "$model" ]] || { model="qwen3:4b"; [[ $mem -ge 16 ]] && model="qwen3:8b"; envset AGENT_MODEL "$model"; }
  say "machine has ${mem} GB; local model $model"
  if ! grep -q "^${model}" <<< "$(ollama list 2>/dev/null)"; then spin "pulling $model (a few minutes, once)" ollama pull "$model" || fail "ollama pull $model failed; see $LOG"; fi
  [[ "$(uname -s)" == Linux ]] && { envset OLLAMA_URL "http://172.17.0.1:11434"; warn "Linux: the ollama service must listen on 0.0.0.0 (systemctl edit ollama, Environment=OLLAMA_HOST=0.0.0.0) so the container reaches it"; }
  [[ -n "$(envget TELEGRAM_BOT_TOKEN)" && -n "$(envget TELEGRAM_CHAT_IDS)" ]] || warn "no Telegram yet: run planetai telegram, or the model has nobody to talk to"
  profiles_add agent
  spin "building the agent" docker compose build agent || fail "could not build the agent container; see $LOG"
  spin "starting it" docker compose up -d agent || fail "could not start the agent container; see $LOG"
  sleep 5; docker compose logs --tail 3 agent 2>/dev/null | sed 's/^/     /'
  echo
  say "running. Message your bot:  is the node healthy?   /act 23 closed the windows   /model"
  echo "  Its actions show in the audit trail as '$(envget AGENT_NAME || echo local-model)/<rung>'. Stop: planetai agent stop.  Logs: planetai logs agent"
}

# runtime_set KEY VALUE [KEY VALUE ...]: write settings where the dashboard writes them, so .env and the dashboard agree.
runtime_set() {
  local tok; tok="$(envget ADMIN_TOKEN)"; [[ -n "$tok" ]] || return 1
  local body="{" k v first=1
  while [[ $# -ge 2 ]]; do k="$1"; v="$2"; shift 2; [[ $first -eq 1 ]] || body+=","; first=0; body+="$(printf '"%s":"%s"' "$k" "$(sed 's/\\/\\\\/g; s/"/\\"/g' <<< "$v")")"; done; body+="}"
  curl -sf -X PUT "http://localhost:$(port)/settings" -H "Authorization: Bearer $tok" -H "X-Agent: planetai-cli" -H 'content-type: application/json' -d "$body" >/dev/null
}

# ---------------------------------------------------------------- the rest
cmd_update()  {
  # backup.sh runs pg_dump through docker. With no runtime it fails at line 44 with "docker: command not
  # found", after the logo, after announcing the backup — which is a long way to travel to say Docker is
  # not installed.
  docker info >/dev/null 2>&1 || fail "there is no container runtime running, so there is nothing to update and nothing to back up.
   Start it, or install one — planetai preflight names the one for this machine — then run this again."
  chmod +x update.sh; logo "updating $(envget NODE_NAME)"; ./update.sh; }
cmd_backup()  { step "Backup"; chmod +x backup.sh; ./backup.sh || fail "see above"; }   # one definition: bash took the last, and the last had no `fail`
cmd_config()  { ( : </dev/tty ) 2>/dev/null || { echo "no terminal here. Edit $HOME_DIR/.env with any editor, then: planetai restart"; return 1; }; "${EDITOR:-nano}" .env </dev/tty && confirm "Restart the node to apply?" && docker compose up -d --force-recreate app; }
cmd_start()   { docker compose up -d && say "started"; }
cmd_stop()    { docker compose down && say "stopped (data kept)"; }
cmd_restart() { docker compose up -d --force-recreate app && say "restarted"; }
cmd_sensors() { [[ "${1:-}" == "--json" ]] && { api /sensors; echo; return; }; api /sensors | json '
for s in d: print("  %-22s %-7s %-9s %-7s  %s" % (s["sensor_id"], s["kind"], "yours" if s["local"] else "reference", "indoor" if s["indoor"] else "outdoor", s["name"]))'; }
cmd_cells()   { [[ "${1:-}" == "--json" ]] && { api /cells; echo; return; }; api /cells | json 'for c in d: print("  %-26s %8s  %-8s %s" % (c["cell"], c["value"], c["state"], c["unit"]))'; }
cmd_version() { echo "planetai-node $(git describe --tags --always 2>/dev/null || cat VERSION 2>/dev/null || echo dev)  ·  $(envget NODE_NAME) @ $(envget NODE_CITY)"; }

case "${1:-help}" in
  preflight) shift; exec bash tools/preflight.sh "$@";;
  setup) shift; cmd_setup "$@";;      status) shift; cmd_status "$@";;     doctor) shift; cmd_doctor "$@";;
  telegram) cmd_telegram;;            test-alert) cmd_test_alert;;  act) shift; cmd_act "$@";;
  report) shift; cmd_report "$@";;
  update) cmd_update;;  backup) cmd_backup;;  config) cmd_config;;  logs) shift; cmd_logs "$@";;
  start) cmd_start;;  stop) cmd_stop;;  restart) cmd_restart;;  sensors) shift; cmd_sensors "$@";;  cells) shift; cmd_cells "$@";;
  mesh) shift; cmd_mesh "$@";;
  meshtastic) cmd_meshtastic;;  reticulum) cmd_reticulum;;
  homeassistant|ha) cmd_homeassistant;;
  packs) shift; cmd_packs "$@";;
  ui|dashboard) cmd_ui;;
  storage) shift; cmd_storage "$@";;
  remove|uninstall) shift; cmd_remove "$@";;
  restore) shift; cmd_restore "$@";;
  ipfs) cmd_ipfs;;
  agent|agents|mcp)
    case "${2:-}" in
      local) cmd_agent_local;;
      stop)  docker compose stop agent >>"$LOG" 2>&1; say "local model stopped";;
      *)     cmd_agent;;
    esac;;
  run) shift; cmd_run "$@";;
  version|-v|--version) cmd_version;;
  geocode) shift; geocode "$*";;   # try a place name without installing anything
  help|-h|--help|"") sed -n '/^#   planetai setup/,/^#   planetai stop/p' "$0" | sed 's/^#//';;
  # An unknown word used to print the usage block and nothing else, so somebody told to run a command
  # that arrived in a later release read a wall of text that simply did not mention it and reported the
  # command "not recognized". Say which word, say which version this node is, and say how to move.
  *)
    here="$(cat VERSION 2>/dev/null || echo dev)"
    warn "there is no \`planetai $1\` in this node."
    printf '   this node is %s. If somebody told you to run it, it arrived in a later release:\n\n     planetai update\n\n' "$here"
    sed -n '/^#   planetai setup/,/^#   planetai stop/p' "$0" | sed 's/^#//'
    exit 1;;
esac
