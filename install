#!/usr/bin/env bash
#   curl -fsSL planetai.fab.city/install | bash
#
# The whole install, from a blank machine. Checks the machine, downloads the tarball and verifies its
# published checksum, then hands off to `planetai setup`, which asks you four things and does the rest.
# Safe to re-run: it updates in place.
#
# It needs curl and tar, which every macOS and every Linux already has. It does not need git, does not
# install a package manager, and never runs sudo.
set -euo pipefail

REPO="${PLANETAI_REPO:-https://github.com/fabcity/planetai-node}"
REF="${PLANETAI_REF:-main}"
DIR="${PLANETAI_HOME:-$HOME/planetai}"
SITE="${PLANETAI_SITE:-https://planetai.fab.city/node0}"

say()  { printf '\033[1;32m>>\033[0m %s\n' "$*"; }
die()  { printf '\n\033[1;31mxx %s\033[0m\n' "$*" >&2; exit 1; }

printf '\033[1;34m'
cat <<'LOGO'

  ██████╗ ██╗      █████╗ ███╗   ██╗███████╗████████╗ █████╗ ██╗
  ██╔══██╗██║     ██╔══██╗████╗  ██║██╔════╝╚══██╔══╝██╔══██╗██║
  ██████╔╝██║     ███████║██╔██╗ ██║█████╗     ██║   ███████║██║
  ██╔═══╝ ██║     ██╔══██║██║╚██╗██║██╔══╝     ██║   ██╔══██║██║
  ██║     ███████╗██║  ██║██║ ╚████║███████╗   ██║   ██║  ██║██║
  ╚═╝     ╚══════╝╚═╝  ╚═╝╚═╝  ╚═══╝╚══════╝   ╚═╝   ╚═╝  ╚═╝╚═╝
LOGO
printf '\033[0m'
echo "  node · observe here, decide here, act here"
# The version this install is about to fetch. Three seconds, and no version rather than a wait if the site
# is slow or this machine is offline — the preflight below is what should report that, with a fix attached.
_v="$(curl -fsSL --max-time 3 "$SITE/get/VERSION" 2>/dev/null || true)"
printf '\033[2m  a Fab City project%s\033[0m\n' "${_v:+ · ${_v}}"
echo

# Every check about this machine happens now, before anything is downloaded and before anybody is asked
# anything. It writes nothing, installs nothing and runs no sudo.
#   0  go   ·   1  something the tester can fix, each with its line   ·   2  this machine is below the floor
if [[ "${PLANETAI_PREFLIGHT:-1}" == 1 ]]; then
  # BASH_SOURCE is UNSET when this script arrives on stdin, which is how everybody runs it: `curl | bash`.
  # Reading it bare under `set -u` aborted right after the logo — the whole install, for every tester, and
  # it took CI running the real pipe to see it. Unset means "no file here": look next to the script when
  # there is one, and fetch otherwise.
  pf_dir="$(dirname "${BASH_SOURCE[0]:-.}")"
  if [[ -r "$pf_dir/tools/preflight.sh" ]]; then
    pf=0; bash "$pf_dir/tools/preflight.sh" || pf=$?   # `; pf=$?` would abort under set -e
  else
    pf_src="$(curl -fsSL "${REPO/github.com/raw.githubusercontent.com}/${REF}/tools/preflight.sh")" \
      || die "could not reach the network to check this machine. Are you online?"
    pf=0; bash -c "$pf_src" || pf=$?
  fi
  # 2 is an answer, not a failure: the table above said which macOS every runtime needs and this one is older.
  # It exits 0 so nothing here reads as a crash.
  [[ $pf -eq 2 ]] && exit 0
  [[ $pf -eq 0 ]] || exit 1
  export PLANETAI_PREFLIGHT_OK=1
fi

# tar is in every base system; curl got us this far. git is not needed and is never asked for: a Mac without
# Xcode Command Line Tools used to hit `xcode-select --install` here — a 2 GB download and a GUI dialog, for a
# tool this script no longer uses.
for t in curl tar; do
  command -v "$t" >/dev/null || die "this needs $t, which is not on this machine.
   Debian/Ubuntu:  sudo apt-get install -y $t
   Fedora:         sudo dnf install -y $t
   Then run the same line again. (I will not install it for you.)"
done

# Where is the node? Three cases, in order:
#   ~/planetai is a checkout or an unpacked node   -> update it
#   ~/planetai/planetai-node is one                -> the layout nodes installed before v0.6 use; keep it in place
#   ~/planetai exists but is neither               -> stop, rather than unpack into someone's folder
if [[ -d "$DIR/.git" || -f "$DIR/VERSION" ]]; then
  :
elif [[ -d "$DIR/planetai-node/.git" || -f "$DIR/planetai-node/VERSION" ]]; then
  DIR="$DIR/planetai-node"
  say "found an existing node at $DIR"
elif [[ -e "$DIR" ]] && [[ -n "$(ls -A "$DIR" 2>/dev/null)" ]]; then
  die "$DIR already exists and is not a node. Move it, or install elsewhere:  PLANETAI_HOME=~/somewhere bash -c \"\$(curl -fsSL ${SITE}/install)\""
fi

# Two ways to get the code. The tarball is the one beta testers use: it needs no GitHub account and the site
# serves it. A git checkout is for people with repository access, and gives them `planetai update` over git.
fetch_tarball() {
  local url="${SITE}/get/planetai-node.tar.gz" tmp
  tmp="$(mktemp -d)"
  say "downloading the node from ${SITE}"
  curl -fsSL "$url" -o "$tmp/n.tar.gz" || { rm -rf "$tmp"; die "could not download $url"; }
  # The checksum is not optional. This used to skip silently when `shasum` was missing (it is macOS's name;
  # Debian ships `sha256sum`), so on some machines the tarball was simply trusted. It is the only path now.
  local sum=""; command -v shasum >/dev/null && sum="shasum -a 256"; [[ -n "$sum" ]] || { command -v sha256sum >/dev/null && sum="sha256sum"; }
  [[ -n "$sum" ]] || { rm -rf "$tmp"; die "no shasum or sha256sum on this machine, so the download cannot be verified. Install one, then run this again."; }
  curl -fsSL "${SITE}/get/SHA256" -o "$tmp/sha" || { rm -rf "$tmp"; die "could not fetch ${SITE}/get/SHA256, so the download cannot be verified."; }
  local want got; want="$(tr -d '[:space:]' < "$tmp/sha")"; got="$($sum "$tmp/n.tar.gz" | awk '{print $1}')"
  [[ "$want" == "$got" ]] || { rm -rf "$tmp"; die "the download does not match its published checksum. Try again; if it repeats, tell us."; }
  say "checksum verified"
  mkdir -p "$DIR"
  tar xzf "$tmp/n.tar.gz" -C "$tmp"
  # keep anything of the operator's: .env, backups, out, packs they added
  ( cd "$tmp/planetai-node" && tar cf - . ) | ( cd "$DIR" && tar xf - --exclude=.env )
  rm -rf "$tmp"
}

if [[ -d "$DIR/.git" ]]; then
  say "updating $DIR"
  git -C "$DIR" fetch -q --tags origin 2>/dev/null || true
  out="$(git -C "$DIR" pull -q --ff-only origin "$REF" 2>&1)" || die "could not update $DIR:
   $out
   If you edited files there, commit or move them, then run this again."
elif [[ -f "$DIR/VERSION" ]]; then
  say "updating $DIR (from ${SITE})"
  fetch_tarball
elif [[ "${PLANETAI_FROM_GIT:-0}" == "1" ]]; then
  command -v git >/dev/null || die "PLANETAI_FROM_GIT=1 needs git, which is not on this machine. Unset it to use the tarball."
  say "getting the code from git → $DIR"
  out="$(git clone -q --branch "$REF" "$REPO" "$DIR" 2>&1)" || die "git clone failed:
   $out"
else
  # The default, for everyone. It was `git clone` when git happened to be there, which meant the install
  # behaved differently on two machines and reached for Xcode Command Line Tools on a bare Mac.
  fetch_tarball
fi

chmod +x "$DIR/bin/planetai" "$DIR"/*.sh 2>/dev/null || true
mkdir -p "$HOME/.local/bin"
ln -sf "$DIR/bin/planetai" "$HOME/.local/bin/planetai"
# make sure `planetai` resolves in new shells. Silent no-op if the PATH line is already there.
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *)
  # a fresh macOS account has no ~/.zshrc yet: create the file for the login shell, or `planetai` is never found
  case "${SHELL:-}" in */zsh) touch "$HOME/.zshrc";; */bash) touch "$HOME/.bashrc";; esac
  for rc in "$HOME/.zshrc" "$HOME/.bashrc"; do
    [[ -f "$rc" ]] && ! grep -q '\.local/bin' "$rc" && printf '\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "$rc"
  done
  export PATH="$HOME/.local/bin:$PATH"
  say "added ~/.local/bin to your PATH (takes effect in new terminals)";;
esac

exec "$DIR/bin/planetai" setup "$@"
