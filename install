#!/usr/bin/env bash
#   curl -fsSL planetai.fab.city/install | bash
#
# The whole install, from a blank machine. Gets git, gets the code, hands off to `planetai setup`,
# which asks you three things and does the rest. Safe to re-run: it updates in place.
set -euo pipefail

REPO="${PLANETAI_REPO:-https://github.com/fabcity/planetai-node}"
REF="${PLANETAI_REF:-main}"
DIR="${PLANETAI_HOME:-$HOME/planetai}"

say()  { printf '\033[1;32m>>\033[0m %s\n' "$*"; }
die()  { printf '\n\033[1;31mxx %s\033[0m\n' "$*" >&2; exit 1; }

printf '\033[1;34m'
cat <<'LOGO'

  ██████╗ ██╗      █████╗ ███╗   ██╗███████╗████████╗ █████╗ ██╗
  ██╔══██╗██║     ██╔══██╗████╗  ██║██╔════╝╚══██╔══╝██╔══██╗██║
  ██████╔╝██║     ███████║██╔██╗ ██║█████╗     ██║   ███████║██║
  ██╔═══╝ ██║     ██╔══██║██║╚██╗██║██╔══╝     ██║   ██╔══██║██║
  ██║     ███████╗██║  ██║██║ ╚████║███████╗   ██║   ██║  ██║██║
  ╚═╝     ╚══════╝╚═╝  ╚═╝╚═╝  ╚═══╝╚══════╝   ╚═╝   ╚═╝  ╚═╝╚═╝
LOGO
printf '\033[0m'
echo "  node · observe here, decide here, act here"
echo

case "$(uname -s)" in
  Darwin)
    if ! xcode-select -p >/dev/null 2>&1; then
      say "macOS needs its command line tools (git, make). A dialog will open. Install them, then run this again."
      xcode-select --install 2>/dev/null || true
      exit 0
    fi ;;
  Linux)
    if ! command -v git >/dev/null; then
      say "installing git"
      if command -v apt-get >/dev/null; then sudo apt-get update -qq && sudo apt-get install -y -qq git curl make
      elif command -v pacman >/dev/null; then sudo pacman -Sy --noconfirm git curl make
      elif command -v dnf >/dev/null; then sudo dnf install -y git curl make
      else die "no package manager I recognise. Install git, then run this again."; fi
    fi ;;
  *) die "unsupported OS: $(uname -s). Linux, macOS, or Windows via WSL2." ;;
esac

# Where is the node? Three cases, in order:
#   ~/planetai is a checkout                    -> update it
#   ~/planetai/planetai-node is a checkout      -> the layout nodes installed before v0.6 use; keep it, don't move a running node
#   ~/planetai exists but is neither            -> stop and say so, rather than clone into someone's folder
if [[ -d "$DIR/.git" ]]; then
  :
elif [[ -d "$DIR/planetai-node/.git" ]]; then
  DIR="$DIR/planetai-node"
  say "found an existing node at $DIR"
elif [[ -e "$DIR" ]] && [[ -n "$(ls -A "$DIR" 2>/dev/null)" ]]; then
  die "$DIR already exists and is not a node. Move it, or install elsewhere:  PLANETAI_HOME=~/somewhere bash -c \"\$(curl -fsSL planetai.fab.city/install)\""
fi

if [[ -d "$DIR/.git" ]]; then
  say "updating $DIR"
  out="$(git -C "$DIR" pull -q --ff-only origin "$REF" 2>&1)" \
    || die "could not update $DIR:
   $out
   If you edited files there, commit or move them, then run this again."
else
  say "getting the code → $DIR"
  out="$(git clone -q --branch "$REF" "$REPO" "$DIR" 2>&1)" || die "git clone failed:
   $out"
fi

chmod +x "$DIR/bin/planetai" "$DIR"/*.sh 2>/dev/null || true
mkdir -p "$HOME/.local/bin"
ln -sf "$DIR/bin/planetai" "$HOME/.local/bin/planetai"
# make sure `planetai` resolves in new shells. Silent no-op if the PATH line is already there.
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *)
  for rc in "$HOME/.zshrc" "$HOME/.bashrc"; do
    [[ -f "$rc" ]] && ! grep -q '\.local/bin' "$rc" && printf '\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "$rc"
  done
  export PATH="$HOME/.local/bin:$PATH"
  say "added ~/.local/bin to your PATH (takes effect in new terminals)";;
esac

exec "$DIR/bin/planetai" setup "$@"
