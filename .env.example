# ---- who and where ----
NODE_NAME=bayu-2                       # lowercase, dashes
NODE_SCALE=community                   # community | city | region   (Full Stack Metrics scale)
NODE_CITY=bali                         # pilot key used in Index cells: bali | barcelona | boston | santiago
NODE_LAT=-8.8271
NODE_LON=115.15709
NODE_TZ=Asia/Makassar                  # WITA. Daily buckets and alert times use this.

# ---- sources (comma-separated; see docs/sensors.md) ----
SC_DEVICES=19880                       # Smart Citizen device ids (the number in smartcitizen.me/kits/<id>)
BAD_ENABLED=1                          # pull Bali Air Dispatch /api/v1/latest as the ambient reference
BAD_RADIUS_KM=15                       # only keep BAD stations within this radius of the node
POLL_SECONDS=300

# ---- alerts ----
TELEGRAM_BOT_TOKEN=                    # from @BotFather. Empty = alerts go to the log only.
TELEGRAM_CHAT_IDS=                     # comma-separated chat ids. Add the bot to a group, get the id from getUpdates.
ALERT_LOCALE=en                        # en | id   (rules.yml carries both)

# ---- network (v0.2, leave empty on node #1) ----
PARENT_API_URL=                        # http://<district-node>:8080  → hourly aggregates go up

# ---- storage ----
POSTGRES_PASSWORD=change-me            # install.sh replaces this
BACKUP_DIR=./backups                   # or a NAS mount, e.g. /Volumes/nas/planetai/bayu-2

# ---- compute (interfaces exist; nothing required) ----
UPSTREAM_MODEL_URL=                    # OpenAI-compatible endpoint: Ollama on this box, vLLM on a partner cluster, or a frontier API
UPSTREAM_COMPUTE_URL=                  # job runner on a district/region box for things a node can't do (Earth-model inference, training)
