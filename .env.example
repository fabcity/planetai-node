# ---- who and where ----
NODE_NAME=bayu-2                       # lowercase, dashes
NODE_KIND=home                         # home | business | community | district — defaults and which packs load; not the Index scale
NODE_SCALE=community                   # community | city | region   (Full Stack Metrics scale)
NODE_CITY=bali                         # pilot key used in Index cells: bali | barcelona | boston | santiago
NODE_LAT=-8.8271
NODE_LON=115.15709
NODE_TZ=Asia/Makassar                  # IANA name. Sets the database session timezone: local midnight and local hours in rules and cells.

# ---- your sensor(s) — set at least one. See docs/sensors.md. ----
# Smart Citizen (cloud API, no LAN needed). The number in smartcitizen.me/kits/<id>. Comma-separate several.
SC_DEVICES=
# AirGradient ONE / Open Air (LAN, no cloud). Hostname printed on the device, or its IP. Comma-separate several.
AIRGRADIENT_HOSTS=
# PurpleAir (LAN, no cloud). Use the IP (the .local name is unreliable). Comma-separate several.
PURPLEAIR_HOSTS=
# Are the LAN sensors above indoors? 1 = yes. (Smart Citizen carries this itself; AirGradient/PurpleAir don't.)
SENSOR_INDOOR=0
# How far from the node a sensor can be and still count as this node's own measurement. A kit of yours further
# than this is yours but not here: it stays out of the ambient average and out of every `live` claim.
LOCAL_RADIUS_M=500

# ---- wider-scale sources (city, region, bioregion, planet) — docs/COVERAGE.md ----
# Open-Meteo: model point sample at this node's coordinates. Free, no key, works anywhere on earth.
# Boundary conditions from the planet scale — context, never rolled up into an index cell.
OPENMETEO_ENABLED=1
# On first start, fill the database from free global sources: 92 days of CAMS air quality history and
# NASA POWER climatology at these coordinates. No key, no sensor needed. Set 0 to start empty.
BOOTSTRAP=1
# CKAN open-data portals to watch, as slug=baseurl pairs. One adapter reads any CKAN portal.
# e.g. open-data-bcn=https://opendata-ajuntament.barcelona.cat/data,analyze-boston=https://data.boston.gov
CKAN_PORTALS=
CKAN_SCALE=city

# ---- reference / context sources (public data around you) ----
# Bali Air Dispatch — island-wide aggregator for Bali. Set 0 outside Bali. (OpenAQ adapter for elsewhere: planned.)
BAD_ENABLED=1
BAD_RADIUS_KM=15
# The ring is other people's stations. These three keep this node's own kit from entering it a second time:
# how close a station has to be to this node before it is assumed to be our own hardware, station ids to drop
# by hand, and whether stations the archive suspects are indoors come through at all.
BAD_MIN_SEPARATION_M=150
BAD_EXCLUDE=
BAD_INCLUDE_INDOOR=0
POLL_SECONDS=300

# ---- integrations ----
# Discover every kit in a Smart Citizen account instead of listing ids. They are all yours; indoor or outdoor
# comes from each kit's own setting. SC_EXCLUDE leaves out kits that belong to another site.
SC_USER=
SC_EXCLUDE=
# Publish local sensors and alerts as Home Assistant entities over MQTT discovery (needs the mqtt profile).
HA_DISCOVERY=0

# ---- alerts ----
# from @BotFather. Empty = alerts go to the log only.
TELEGRAM_BOT_TOKEN=
# comma-separated chat ids. Add the bot to a group, get the id from getUpdates.
TELEGRAM_CHAT_IDS=
# One report every REPORT_EVERY hours in the node's own time zone, and what is allowed to interrupt you between them.
# These three ship blank on purpose: `update.sh` copies new keys here into your .env with whatever value they carry,
# and a node that was reporting twice a day should keep doing that until you say otherwise, not take a new default.
# 3 | 4 | 6 | 8 | 12 | 24 hours between reports. Blank = 6, which is four a day.
REPORT_EVERY=
# The local hour the rhythm starts from, 0-23. Blank = 6, so 06, 12, 18 and 00.
REPORT_ANCHOR=
# auto | brief | standard | deep. Blank = auto. Nothing until a model is in the path of a report.
REPORT_DEPTH=
ALERT_LEVEL=act                        # act | warn | info — what reaches your phone between reports; everything is still recorded
QUIET_HOURS=1
QUIET_FROM=22
QUIET_TO=6
ALERT_LOCALE=en                        # en | id | es   (rules.yml carries en and id; the report carries all three)

# ---- network (v0.2, leave empty on node #1) ----
# http://<district-node>:8080  → hourly aggregates go up
PARENT_API_URL=
# What this node presents to its parent, and what it demands from its own children.
# Without AGGREGATE_TOKEN this node accepts no children at all (POST /aggregates returns 403).
PARENT_TOKEN=
AGGREGATE_TOKEN=

# ---- optional layers (set by `planetai meshtastic` / `planetai reticulum`; leave alone by hand) ----
# Which extra containers to run: mqtt, reticulum, or both, comma-separated. Empty = the two base containers only.
COMPOSE_PROFILES=
# Meshtastic via MQTT. The gateway radio publishes to the node's Mosquitto with these credentials.
MQTT_HOST=
MQTT_USER=
MQTT_PASS=
# Mesh node ids that are indoors, e.g. !abcd1234,!beef5678  (mesh sensors default to outdoor)
MESH_INDOOR_NODES=
# Send act-level alerts back over the mesh (needs downlink enabled on the gateway's channel)
MESH_ALERTS=0
# The gateway's node number (decimal), used as the sender for downlink. `planetai meshtastic` shows how to find it.
MESH_GATEWAY_NODE_NUM=0
# Reticulum bridge (LXMF). Alert destinations: LXMF address hashes from Sideband, comma-separated, no spaces.
RETICULUM_URL=
RETICULUM_ALERT_DESTINATIONS=

# ---- packs (community extensions — docs/PACKS.md) ----
# Empty = load every pack in packs/. Or list ids to load only those.
PACKS_ENABLED=
# Data packs (rules/cells) always load. Code packs (adapter.py) run Python with this node's privileges:
# read the code, then set this to 1.
PACKS_ALLOW_CODE=0

# ---- ports ----
APP_PORT=8080                          # change if something else on this machine already uses 8080

# ---- storage ----
POSTGRES_PASSWORD=change-me            # install.sh replaces this
# install.sh generates ADMIN_TOKEN; it unlocks the GUI's settings pages. planetai ui shows it.
ADMIN_TOKEN=
# read-only token a NAS presents to fetch /backups; generated by install/update. planetai storage shows it.
BACKUP_TOKEN=
BACKUP_DIR=./backups                   # or a NAS mount, e.g. /Volumes/nas/planetai/bayu-2 — must be mounted, or the backup refuses
BACKUP_KEEP=30                         # days of dumps to keep in BACKUP_DIR
# Off-machine copy after each backup: an rclone remote:path (S3, B2, R2, Drive, Dropbox, SFTP, WebDAV, Nextcloud…). rclone config once.
BACKUP_REMOTE=
# Open-data export each night (hourly means, cells, alerts, rho — never raw) to exports/<node>/YYYY-MM-DD.json
EXPORT_ENABLED=1
# Publish each export to IPFS (planetai ipfs turns this on and starts the container)
IPFS_PUBLISH=0
# Where the live database lives. Blank = a Docker volume on this machine. A path = a LOCAL disk or partition only.
DATA_DIR=

# ---- code packs (only needed if you enable the pack that uses them; see packs/<id>/README.md) ----
# earth-engine: a registered Earth Engine project and a service-account key
EE_PROJECT=
EE_SERVICE_ACCOUNT=
EE_KEY_FILE=/app/config/ee-key.json
# coast: refuse to report if the nearest ocean grid cell is further away than this
COAST_MAX_KM=30
# NOTE: no spaces after `=` anywhere in this file. `VAR= value` is a shell command, not an assignment.

# ---- a model that runs the node (planetai agent local) ----
# Ollama on this machine runs the `local` rung. The bot also uses a stronger model when it can reach one; these are
# runtime settings, so the Model page in the dashboard changes them live.
OLLAMA_URL=http://host.docker.internal:11434
AGENT_MODEL=qwen3:4b                   # 8 GB machine. qwen3:8b on 16 GB+. Must do tool calling; gemma3 does not.
AGENT_NAME=local-model                 # how its actions appear in the audit trail
# strongest = online, remote, local in that order — every question goes to the online model when one is set.
# fallback  = your remote model, then online, then the small local one. Online sits above local on purpose: a rung
#             is skipped only when it fails, and a 4B model never fails, it answers badly. Local is the floor that
#             still works with no internet.
# private   = never online. Nothing leaves the network.
AGENT_PREFER=strongest
# A bigger local model on your tailnet, e.g. http://100.107.91.18:8082/v1
# Comments go ABOVE a key that ships blank, never after it: compose's env_file strips a trailing comment only when
# the key has a value, so `KEY=   # note` hands the container "# note" as the value. That is how node #1 came to
# hold the text of this file's own comment in AGENT_ONLINE_URL.
AGENT_REMOTE_URL=
AGENT_REMOTE_MODEL=gpt-oss-120b
AGENT_REMOTE_KEY=
# https://api.anthropic.com/v1 · https://api.openai.com/v1 · https://generativelanguage.googleapis.com/v1beta/openai
# The URL and nothing else. A value that is not a URL is not a rung: the agent logs it and skips that rung.
AGENT_ONLINE_URL=
AGENT_ONLINE_MODEL=claude-sonnet-4-6
AGENT_ONLINE_KEY=
