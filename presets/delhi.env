# Delhi, India. ./install.sh --preset delhi --name <yours>
# Reference for "outside" is the CAMS model; India has no key-free aggregator equivalent to Bali's.
# For measured stations here, OpenAQ carries CPCB data but needs a free API key. See docs/PREFILL.md.
NODE_CITY=delhi
NODE_LAT=28.6139
NODE_LON=77.2090
NODE_TZ=Asia/Kolkata
ALERT_LOCALE=en
BAD_ENABLED=0
CKAN_PORTALS=
