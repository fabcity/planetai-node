# Boston, Massachusetts — pilot site. ./install.sh --preset boston --name <yours>
NODE_CITY=boston
NODE_LAT=42.3601
NODE_LON=-71.0589
NODE_TZ=America/New_York
ALERT_LOCALE=en
BAD_ENABLED=0
CKAN_PORTALS=analyze-boston=https://data.boston.gov
# What this place watches, in order. The first issue is where the dashboard starts.
# This is a guess made from a map. Change it: what matters here is decided by the people who
# live here, not by which pack somebody wrote first.
NODE_ISSUES=heat,air
