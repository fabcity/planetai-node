# Bali, Indonesia — pilot site. ./install.sh --preset bali --name <yours>
NODE_CITY=bali
NODE_LAT=-8.6500
NODE_LON=115.2167
NODE_TZ=Asia/Makassar
ALERT_LOCALE=id
BAD_ENABLED=1
BAD_RADIUS_KM=8
CKAN_PORTALS=bali-satu-data=https://balisatudata.baliprov.go.id
# What this place watches, in order. The first issue is where the dashboard starts.
# This is a guess made from a map. Change it: what matters here is decided by the people who
# live here, not by which pack somebody wrote first.
NODE_ISSUES=air,heat,land,coast
