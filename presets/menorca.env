# Menorca, Illes Balears, Spain. ./install.sh --preset menorca --name <yours>
# Coordinates are Maó, the island's capital. A node elsewhere on Menorca should pass --lat --lon:
# the island is 50 km end to end and the south coast is a different place from the north.
NODE_CITY=menorca
NODE_LAT=39.8885
NODE_LON=4.2658
NODE_TZ=Europe/Madrid
ALERT_LOCALE=es
BAD_ENABLED=0
# Govern de les Illes Balears open-data catalogue, CKAN. 14,731 datasets, 164 of them Menorca's.
# Tested 2026-09-12: /api/3/action/package_search?rows=0 answers 200.
CKAN_PORTALS=menorca=https://intranet.caib.es/opendatacataleg
# What this place watches, in order. The first issue is where the dashboard starts.
# This is a guess made from a map. Change it: what matters here is decided by the people who
# live here, not by which pack somebody wrote first. Menorca is a UNESCO Biosphere Reserve whose
# summer population is several times its winter one, so water and tourism pressure probably belong
# at the top of this list — neither is an issue yet.
NODE_ISSUES=coast,heat,air,land
