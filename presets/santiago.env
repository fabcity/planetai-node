# Santiago, Chile — pilot site. ./install.sh --preset santiago --name <yours>
NODE_CITY=santiago
NODE_LAT=-33.4489
NODE_LON=-70.6693
NODE_TZ=America/Santiago
ALERT_LOCALE=en
BAD_ENABLED=0
CKAN_PORTALS=datos-gob-cl=https://datos.gob.cl
# What this place watches, in order. The first issue is where the dashboard starts.
# This is a guess made from a map. Change it: what matters here is decided by the people who
# live here, not by which pack somebody wrote first.
NODE_ISSUES=air,heat
