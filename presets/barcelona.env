# Barcelona, Catalonia — pilot site. ./install.sh --preset barcelona --name <yours>
NODE_CITY=barcelona
NODE_LAT=41.3874
NODE_LON=2.1686
NODE_TZ=Europe/Madrid
ALERT_LOCALE=en
BAD_ENABLED=0
CKAN_PORTALS=open-data-bcn=https://opendata-ajuntament.barcelona.cat/data
# What this place watches, in order. The first issue is where the dashboard starts.
# This is a guess made from a map. Change it: what matters here is decided by the people who
# live here, not by which pack somebody wrote first.
NODE_ISSUES=heat,air
